contentArea.Position = UDim2.new(0, 145, 0, 35)
contentArea.BackgroundTransparency = 1
contentArea.Parent = mainFrame

local function createPage()
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, -10, 1, -5)
	scroll.Position = UDim2.new(0, 0, 0, 0)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.ScrollBarImageColor3 = BORDER_COLOR
	table.insert(updateBorderColorFuncs, function(c) scroll.ScrollBarImageColor3 = c end)

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 8)
	layout.Parent = scroll

	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
	end)

	return scroll
end

local function createMenuButton(parent, text, layoutOrder)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -10, 0, 36)
	btn.BackgroundColor3 = PANEL_COLOR
	btn.Text = "  " .. text
	btn.TextColor3 = TEXT_COLOR
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 14
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.LayoutOrder = layoutOrder or 0
	btn.Parent = parent

	local stroke = Instance.new("UIStroke")
	stroke.Color = BORDER_COLOR
	stroke.Thickness = 1
	stroke.Parent = btn
	table.insert(updateBorderColorFuncs, function(c) stroke.Color = c end)

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = btn

	return btn
end

