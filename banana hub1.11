---------------------------------------------------------
-- ロジック定義
---------------------------------------------------------
local function getClosestPlayer()
	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
	local myPos = myChar.HumanoidRootPart.Position
	local closest, shortest = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local dist = (p.Character.HumanoidRootPart.Position - myPos).Magnitude
			if dist < shortest then
				shortest = dist
				closest = p
			end
		end
	end
	return closest
end

local function getClosestBlogmanItem()
	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
	local myPos = myChar.HumanoidRootPart.Position
	local closestItem, shortest = nil, math.huge
	for _, obj in ipairs(workspace:GetDescendants()) do
		if not obj:IsDescendantOf(myChar) and (obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Tool")) then
			local nameLower = obj.Name:lower()
			if nameLower:find("blogman") or nameLower:find("ブログマン") or nameLower:find("blobman") then
				local part = obj:IsA("BasePart") and obj or obj:FindFirstChildOfClass("BasePart")
				if part then
					local dist = (part.Position - myPos).Magnitude
					if dist < shortest then
						shortest = dist
						closestItem = part
					end
				end
			end
		end
	end
	return closestItem
end

-- FF内アイテム持ち込み
local isFFBringActive = false
ffBringBtn.MouseButton1Click:Connect(function()
	isFFBringActive = not isFFBringActive
	ffBringBtn.Text = isFFBringActive and "  FF内アイテム持込: ON" or "  FF内アイテム持込: OFF"

	if isFFBringActive then
		task.spawn(function()
			while isFFBringActive do
				for _, v in ipairs(workspace:GetDescendants()) do
					if v:IsA("ForceField") or (v:IsA("BasePart") and (v.Name:lower():find("barrier") or v.Name:lower():find("forcefield") or v.Name:lower():find("shield") or v.Name:lower():find("house"))) then
						if v:IsA("BasePart") then
							v.CanCollide = false
						end
					end
				end
				
				local myChar = LocalPlayer.Character
				if myChar then
					for _, tool in ipairs(myChar:GetChildren()) do
						if tool:IsA("Tool") then
							for _, p in ipairs(tool:GetDescendants()) do
								if p:IsA("BasePart") then
									p.CanCollide = false
								end
							end
						end
					end
				end
				RunService.Heartbeat:Wait()
			end
		end)
	end
end)

-- サイレントエイム
local isSilentAimActive = false
local aimConnection = nil

silentAimBtn.MouseButton1Click:Connect(function()
	isSilentAimActive = not isSilentAimActive
	silentAimBtn.Text = isSilentAimActive and "  サイレントエイム: ON" or "  サイレントエイム: OFF"

	if isSilentAimActive then
		aimConnection = UserInputService.InputBegan:Connect(function(input, gpe)
			if gpe then return end
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				local targetPlayer = getClosestPlayer()
				if targetPlayer and targetPlayer.Character then
					local targetHead = targetPlayer.Character:FindFirstChild("Head") or targetPlayer.Character:FindFirstChild("HumanoidRootPart")
					local myChar = LocalPlayer.Character
					if targetHead and myChar then
						local tool = myChar:FindFirstChildOfClass("Tool")
						if tool then
							for _, v in ipairs(tool:GetDescendants()) do
								if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
									pcall(function()
										v:FireServer(targetHead.Position, targetHead)
									end)
								end
							end
							for _, part in ipairs(workspace:GetChildren()) do
								if part:IsA("BasePart") and (part.Name:lower():find("bullet") or part.Name:lower():find("projectile")) then
									part.CFrame = targetHead.CFrame
								end
							end
						end
					end
				end
			end
		end)
	else
		if aimConnection then
			aimConnection:Disconnect()
			aimConnection = nil
		end
	end
end)

-- 触れたアイテムを弾き飛ばす
local isTouchFlyActive = false
touchFlyItemBtn.MouseButton1Click:Connect(function()
	isTouchFlyActive = not isTouchFlyActive
	touchFlyItemBtn.Text = isTouchFlyActive and "  触れたアイテムを弾き飛ばし: ON" or "  触れたアイテムを弾き飛ばし: OFF"

	if isTouchFlyActive then
		task.spawn(function()
			local overlapParams = OverlapParams.new()
			overlapParams.FilterType = Enum.RaycastFilterType.Exclude

			while isTouchFlyActive do
				local myChar = LocalPlayer.Character
				if myChar and myChar:FindFirstChild("HumanoidRootPart") then
					local myHRP = myChar.HumanoidRootPart
					
					local excludeList = {myChar}
					for _, p in ipairs(Players:GetPlayers()) do
						if p.Character then
							table.insert(excludeList, p.Character)
						end
					end
					overlapParams.FilterDescendantsInstances = excludeList

					local parts = workspace:GetPartsInPart(myHRP, overlapParams)
					for _, obj in ipairs(parts) do
						if obj:IsA("BasePart") and not obj.Anchored then
							local flyDir = (obj.Position - myHRP.Position).Unit
							if flyDir ~= flyDir then flyDir = myHRP.CFrame.LookVector end
							local pushVelocity = (flyDir * 400) + Vector3.new(0, 200, 0)
							obj.Velocity = pushVelocity
							pcall(function()
								obj.AssemblyLinearVelocity = pushVelocity
							end)
						end
					end
				end
				task.wait(0.1)
			end
		end)
	end
end)

-- Blogman
local isFastShootActive = false
blogmanBtn.MouseButton1Click:Connect(function()
	isFastShootActive = not isFastShootActive
	blogmanBtn.Text = isFastShootActive and "  Blogman 爆速掴み＆自動射撃: ON" or "  Blogman 爆速掴み＆自動射撃: OFF"
	if isFastShootActive then
		task.spawn(function()
			while isFastShootActive do
				local myChar = LocalPlayer.Character
				if myChar and myChar:FindFirstChild("HumanoidRootPart") then
					local myHRP = myChar.HumanoidRootPart
					local blogmanItem = getClosestBlogmanItem()
					if blogmanItem then
						myHRP.CFrame = blogmanItem.CFrame * CFrame.new(0, 3, 0)
					end
					local targetPlayer = getClosestPlayer()
					if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
						myHRP.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 1, -2)
						for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
							if item:IsA("Tool") then item.Parent = myChar end
						end
						for _, tool in ipairs(myChar:GetChildren()) do
							if tool:IsA("Tool") then tool:Activate() end
						end
					end
				end
				RunService.Heartbeat:Wait()
			end
		end)
	end
end)

-- 全アイテム吸引
itemBringBtn.MouseButton1Click:Connect(function()
	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
	local targetCFrame = myChar.HumanoidRootPart.CFrame
	task.spawn(function()
		for loop = 1, 10 do
			for _, obj in ipairs(workspace:GetDescendants()) do
				if not obj:IsDescendantOf(myChar) then
					local isPlayerPart = false
					for _, p in ipairs(Players:GetPlayers()) do
						if p.Character and obj:IsDescendantOf(p.Character) then isPlayerPart = true break end
					end
					if not isPlayerPart then
						if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
							obj.Handle.CFrame = targetCFrame
						elseif obj:IsA("BasePart") and not obj.Anchored then
							if obj:FindFirstChildOfClass("TouchTransmitter") or obj:FindFirstChildOfClass("ClickDetector") or obj.Name:lower():find("item") or obj.Name:lower():find("coin") then
								obj.CFrame = targetCFrame
								obj.Velocity = Vector3.new(0, 0, 0)
							end
						end
					end
				end
			end
			task.wait(0.05)
		end
	end)
	itemBringBtn.Text = "  引き寄せ完了!"
	task.wait(1.5)
	itemBringBtn.Text = "  全アイテムを完全吸引"
end)

-- 津波発生
local activeTsunami, moveConnection
tsunamiBtn.MouseButton1Click:Connect(function()
	if moveConnection then moveConnection:Disconnect() moveConnection = nil end
	if activeTsunami then activeTsunami:Destroy() activeTsunami = nil end

	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
	local hrp = myChar.HumanoidRootPart
	local farPosition = hrp.CFrame * CFrame.new(0, 20, -500)

	local tsunami = Instance.new("Part")
	tsunami.Name = "TsunamiWave"
	tsunami.Size = Vector3.new(400, 80, 15)
	tsunami.CFrame = CFrame.new(farPosition.Position, hrp.Position)
	tsunami.Anchored = true
	tsunami.CanCollide = false
	tsunami.Material = Enum.Material.ForceField
	tsunami.Color = Color3.fromRGB(0, 120, 255)
	tsunami.Transparency = 0.25
	tsunami.Parent = workspace
	activeTsunami = tsunami

	tsunami.Touched:Connect(function(hit)
		if not hit or hit:IsDescendantOf(myChar) then return end
		local pushVector = tsunami.CFrame.LookVector * 250 + Vector3.new(0, 150, 0)
		local parentModel = hit.Parent
		if parentModel and parentModel:FindFirstChildOfClass("Humanoid") then
			local targetHRP = parentModel:FindFirstChild("HumanoidRootPart")
			if targetHRP then targetHRP.Velocity = pushVector end
		elseif hit:IsA("BasePart") and not hit.Anchored then
			hit.Velocity = pushVector
		end
	end)

	moveConnection = RunService.Heartbeat:Connect(function()
		if tsunami and tsunami.Parent then
			tsunami.CFrame = tsunami.CFrame * CFrame.new(0, 0, -2.0)
		else
			if moveConnection then moveConnection:Disconnect() moveConnection = nil end
		end
	end)
end)

-- Anti-Kick
local isAntiKickEnabled = false
antiKickBtn.MouseButton1Click:Connect(function()
	isAntiKickEnabled = not isAntiKickEnabled
	antiKickBtn.Text = isAntiKickEnabled and "  Anti-Kick: ON" or "  Anti-Kick: OFF"
	if isAntiKickEnabled then
		pcall(function()
			local mt = getrawmetatable(game)
			if setreadonly then setreadonly(mt, false) end
			local oldNamecall = mt.__namecall
			mt.__namecall = newcclosure(function(self, ...)
				if tostring(getnamecallmethod()):lower() == "kick" and self == LocalPlayer then
					return
				end
				return oldNamecall(self, ...)
			end)
		end)
	end
end)

-- ラグ削除
lagRemoveBtn.MouseButton1Click:Connect(function()
	Lighting.GlobalShadows = false
	Lighting.FogEnd = 9e9
	for _, v in ipairs(Lighting:GetChildren()) do
		if v:IsA("PostEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") then v.Enabled = false end
	end
	for _, desc in ipairs(workspace:GetDescendants()) do
		if desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Smoke") or desc:IsA("Fire") or desc:IsA("Sparkles") then
			desc.Enabled = false
		elseif desc:IsA("Decal") or desc:IsA("Texture") then
			desc.Texture = ""
		end
	end
	lagRemoveBtn.Text = "  ラグ削除: 完了"
end)

-- 全員爆速吹き飛ばし
local isLineLaunchActive = false
launchAllBtn.MouseButton1Click:Connect(function()
	isLineLaunchActive = not isLineLaunchActive
	launchAllBtn.Text = isLineLaunchActive and "  全員爆速吹き飛ばし: ON" or "  全員爆速吹き飛ばし: OFF"
	if isLineLaunchActive then
		task.spawn(function()
			while isLineLaunchActive do
				local myChar = LocalPlayer.Character
				if myChar and myChar:FindFirstChild("HumanoidRootPart") then
					local myHRP = myChar.HumanoidRootPart
					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
							local targetHRP = p.Character.HumanoidRootPart
							local dir = (targetHRP.Position - myHRP.Position).Unit
							if dir ~= dir then dir = myHRP.CFrame.LookVector end
							targetHRP.Velocity = (dir * 2000) + Vector3.new(0, 1000, 0)
						end
					end
				end
				RunService.Heartbeat:Wait()
			end
		end)
	end
end)

-- 自動飛行
local isAutoFlyActive, flyBV, flyBG = false, nil, nil
autoFlyBtn.MouseButton1Click:Connect(function()
	isAutoFlyActive = not isAutoFlyActive
	autoFlyBtn.Text = isAutoFlyActive and "  Fly automatically: ON" or "  Fly automatically: OFF"
	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
	local hrp = myChar.HumanoidRootPart
	local humanoid = myChar:FindFirstChildOfClass("Humanoid")

	if isAutoFlyActive then
		if humanoid then humanoid.PlatformStand = true end
		flyBV = Instance.new("BodyVelocity")
		flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		flyBV.Parent = hrp
		flyBG = Instance.new("BodyGyro")
		flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
		flyBG.Parent = hrp

		task.spawn(function()
			while isAutoFlyActive and myChar and myChar.Parent do
				local camera = workspace.CurrentCamera
				if camera then
					flyBV.Velocity = camera.CFrame.LookVector * 50
					flyBG.CFrame = camera.CFrame
				end
				RunService.RenderStepped:Wait()
			end
			if flyBV then flyBV:Destroy() end
			if flyBG then flyBG:Destroy() end
			if humanoid then humanoid.PlatformStand = false end
		end)
	else
		if flyBV then flyBV:Destroy() end
		if flyBG then flyBG:Destroy() end
		if humanoid then humanoid.PlatformStand = false end
	end
end)

-- 不動
local isImmovableActive = false
immovableBtn.MouseButton1Click:Connect(function()
	isImmovableActive = not isImmovableActive
	immovableBtn.Text = isImmovableActive and "  不動(掴み/押し無効): ON" or "  不動(掴み/押し無効): OFF"
	if isImmovableActive then
		task.spawn(function()
			while isImmovableActive do
				local myCharActual = LocalPlayer.Character
				if myCharActual and myCharActual:FindFirstChild("HumanoidRootPart") then
					local hrp = myCharActual.HumanoidRootPart
					hrp.Velocity = Vector3.zero
					hrp.RotVelocity = Vector3.zero
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.AssemblyAngularVelocity = Vector3.zero
				end
				RunService.Heartbeat:Wait()
			end
		end)
	end
end)

-- 掴んだ人の足を消去
local isRemoveLegsActive = false
removeLegsOnGrabBtn.MouseButton1Click:Connect(function()
	isRemoveLegsActive = not isRemoveLegsActive
	removeLegsOnGrabBtn.Text = isRemoveLegsActive and "  掴んだ人の足を消去: ON" or "  掴んだ人の足を消去: OFF"

	if isRemoveLegsActive then
		task.spawn(function()
			while isRemoveLegsActive do
				local myChar = LocalPlayer.Character
				if myChar and myChar:FindFirstChild("HumanoidRootPart") then
					local myHRP = myChar.HumanoidRootPart
					local closestP = getClosestPlayer()
					if closestP and closestP.Character then
						local targetHRP = closestP.Character:FindFirstChild("HumanoidRootPart")
						if targetHRP then
							local dist = (targetHRP.Position - myHRP.Position).Magnitude
							if dist <= 6 then
								for _, partName in ipairs({"LeftLeg", "RightLeg", "LeftLowerLeg", "RightLowerLeg", "LeftUpperLeg", "RightUpperLeg", "Left Foot", "Right Foot"}) do
									local leg = closestP.Character:FindFirstChild(partName)
									if leg then
										leg:Destroy()
									end
								end
							end
						end
					end
				end
				task.wait(0.2)
			end
		end)
	end
end)

-- 超・ラグ激減
antiLagBtn.MouseButton1Click:Connect(function()
	Lighting.GlobalShadows = false
	Lighting.FogEnd = 9e9
	Lighting.Brightness = 2
	for _, v in ipairs(Lighting:GetChildren()) do
		if v:IsA("PostEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
			v:Destroy()
		end
	end
	for _, desc in ipairs(workspace:GetDescendants()) do
		if desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Smoke") or desc:IsA("Fire") or desc:IsA("Sparkles") or desc:IsA("Explosion") then
			desc:Destroy()
		elseif desc:IsA("Decal") or desc:IsA("Texture") then
			desc:Destroy()
		elseif desc:IsA("BasePart") then
			desc.Material = Enum.Material.SmoothPlastic
			desc.Reflectance = 0
			desc.CastShadow = false
		elseif desc:IsA("MeshPart") then
			desc.Material = Enum.Material.SmoothPlastic
			desc.TextureID = ""
			desc.CastShadow = false
		end
	end
	antiLagBtn.Text = "  超・ラグ激減: 完了（激軽化！）"
	task.wait(1.5)
	antiLagBtn.Text = "  超・ラグ激減（Anti-lag+）を実行"
end)

-- FPS表示カウンター
local isFpsActive = false
local fpsGui = nil
local fpsConnection = nil

fpsToggleBtn.MouseButton1Click:Connect(function()
	isFpsActive = not isFpsActive
	fpsToggleBtn.Text = isFpsActive and "  FPS表示カウンター: ON" or "  FPS表示カウンター: OFF"

	if isFpsActive then
		fpsGui = Instance.new("ScreenGui")
		fpsGui.Name = "FpsCounterGui"
		fpsGui.ResetOnSpawn = false
		fpsGui.Parent = PlayerGui

		local fpsFrame = Instance.new("TextButton")
		fpsFrame.Size = UDim2.new(0, 140, 0, 40)
		fpsFrame.Position = UDim2.new(0.5, -70, 0.4, -20)
		fpsFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
		fpsFrame.TextColor3 = Color3.fromRGB(255, 255, 255)
		fpsFrame.TextSize = 15
		fpsFrame.Font = Enum.Font.SourceSansBold
		fpsFrame.Text = "FPS: 60"
		fpsFrame.AutoButtonColor = false
		fpsFrame.Parent = fpsGui

		local fpsStroke = Instance.new("UIStroke")
		fpsStroke.Color = BORDER_COLOR
		fpsStroke.Thickness = 1.5
		fpsStroke.Parent = fpsFrame
		table.insert(updateBorderColorFuncs, function(c) fpsStroke.Color = c end)

		local fpsCorner = Instance.new("UICorner")
		fpsCorner.CornerRadius = UDim.new(0, 6)
		fpsCorner.Parent = fpsFrame

		makeDraggable(fpsFrame)

		local lastTick = tick()
		local frameCount = 0
		fpsConnection = RunService.RenderStepped:Connect(function()
			frameCount = frameCount + 1
			local currentTick = tick()
			if currentTick - lastTick >= 0.5 then
				local fps = math.floor((frameCount / (currentTick - lastTick)) + 0.5)
				fpsFrame.Text = "FPS: " .. tostring(fps)
				frameCount = 0
				lastTick = currentTick
			end
		end)
	else
		if fpsConnection then
			fpsConnection:Disconnect()
			fpsConnection = nil
		end
		if fpsGui then
			fpsGui:Destroy()
			fpsGui = nil
		end
	end
end)

-- 他プレイヤー激重化
local isLagOtherActive = false
lagOtherBtn.MouseButton1Click:Connect(function()
	isLagOtherActive = not isLagOtherActive
	lagOtherBtn.Text = isLagOtherActive and "  他プレイヤー激重化: ON" or "  他プレイヤー激重化: OFF"

	if isLagOtherActive then
		task.spawn(function()
			while isLagOtherActive do
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= LocalPlayer and p.Character then
						for _, part in ipairs(p.Character:GetChildren()) do
							if part:IsA("BasePart") then
								pcall(function()
									part.Velocity = Vector3.new(math.random(-50, 50), math.random(100, 300), math.random(-50, 50))
								end)
							end
						end
					end
				end
				task.wait(0.2)
			end
		end)
	end
end)
