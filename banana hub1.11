table.insert(tabPages, page2)
table.insert(tabPages, page3)
table.insert(tabPages, page4)

for i, tabInfo in ipairs(tabButtons) do
	tabInfo.Btn.MouseButton1Click:Connect(function()
		for j, page in ipairs(tabPages) do
			page.Visible = (j == i)
		end
		for j, info in ipairs(tabButtons) do
			if j == i then
				info.Btn.BackgroundColor3 = PANEL_COLOR
				info.Btn.TextColor3 = TEXT_COLOR
				info.Stroke.Color = BORDER_COLOR
			else
				info.Btn.BackgroundColor3 = BG_COLOR
				info.Btn.TextColor3 = SUBTEXT_COLOR
				info.Stroke.Color = Color3.fromRGB(60, 60, 60)
			end
		end
	end)
end

