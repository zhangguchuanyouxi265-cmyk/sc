-- 全体の枠（ボーダー）を動的に変更する関数を保持・管理用リスト
local updateBorderColorFuncs = {}
local function applyBorderColor(newColor)
	BORDER_COLOR = newColor
	mainStroke.Color = newColor
	for _, fn in ipairs(updateBorderColorFuncs) do
		pcall(fn, newColor)
	end
end

