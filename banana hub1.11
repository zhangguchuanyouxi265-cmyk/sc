local tabButtons = {}
local tabPages = {}

local function createTabButton(name, index)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -10, 0, 26)
	btn.Position = UDim2.new(0, 5, 0, 5 + (index - 1) * 32)
	btn.BackgroundColor3 = (index == 1) and PANEL_COLOR or BG_COLOR
	btn.Text = name
	btn.TextColor3 = (index == 1) and TEXT_COLOR or SUBTEXT_COLOR
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 12
	btn.Parent = sidebar

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = btn

	local stroke = Instance.new("UIStroke")
	stroke.Color = (index == 1) and BORDER_COLOR or Color3.fromRGB(60, 60, 60)
	stroke.Thickness = 1
	stroke.Parent = btn
	
	if index == 1 then
		table.insert(updateBorderColorFuncs, function(c)
			if btn.BackgroundColor3 == PANEL_COLOR then
				stroke.Color = c
			end
		end)
	end

	table.insert(tabButtons, {Btn = btn, Stroke = stroke, Index = index})
	return btn
end

createTabButton("メイン機能", 1)
createTabButton("特殊機能", 2)
createTabButton("設定・情報", 3)
createTabButton("設定", 4)

