local modeButtons = {}
do
    local columns, gap = 3, 6
    local width = (FRAME_WIDTH - 24 - gap * (columns - 1)) / columns
    for i, mode in ipairs(MODES) do
        local col = (i - 1) % columns
        local row = math.floor((i - 1) / columns)
        local b = Instance.new("TextButton")
        b.Size = UDim2.fromOffset(width, 32)
        b.Position = UDim2.fromOffset(12 + col * (width + gap), 50 + row * 38)
        b.BackgroundColor3 = COLOR_MODE_IDLE
        b.BorderSizePixel = 0
        b.Text = mode
        b.TextColor3 = Color3.new(1, 1, 1)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 13
        b.Parent = body
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
        modeButtons[i] = b
    end
end

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -24, 1, -134)
status.Position = UDim2.fromOffset(12, 130)
status.BackgroundTransparency = 1
status.Text = "Status: off"
status.TextColor3 = Color3.fromRGB(180, 182, 195)
status.TextWrapped = true
status.TextXAlignment = Enum.TextXAlignment.Left
status.TextYAlignment = Enum.TextYAlignment.Top
status.Font = Enum.Font.Gotham
status.TextSize = 13
status.Parent = body

local function refreshModeButtons()
    for i, b in ipairs(modeButtons) do
        b.BackgroundColor3 = (i == modeIndex) and COLOR_MODE_ACTIVE or COLOR_MODE_IDLE
    end
end
refreshModeButtons()

do -- dragging (title area only)
    local dragging, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            local relativeY = input.Position.Y - frame.AbsolutePosition.Y
            if relativeY > FRAME_HEIGHT_CLOSED then return end
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

-- ===================== Behavior =====================
local collapsed = false
collapseButton.MouseButton1Click:Connect(function()
    collapsed = not collapsed
    body.Visible = not collapsed
    collapseButton.Text = collapsed and "+" or "-"
    frame.Size = UDim2.fromOffset(FRAME_WIDTH, collapsed and FRAME_HEIGHT_CLOSED or FRAME_HEIGHT_OPEN)
end)

local function fixedClockTime(mode)
    if mode == "Night" then return CONFIG.NightClockTime end
    if mode == "Dawn" then return CONFIG.DawnClockTime end
    if mode == "Day" then return CONFIG.DayClockTime end
    if mode == "Dusk" then return CONFIG.DuskClockTime end
    return nil
end

local function windStatus()
    if not CONFIG.Wind then return "" end
    if windWorks == false then
        return " Wind: GlobalWind could not be set on this executor/game."
    end
    return " Wind on (affects terrain grass only)."
end

local function applyMode()
    local mode = MODES[modeIndex]
    local clock = fixedClockTime(mode)
    if clock then
        Lighting.ClockTime = clock
    elseif mode == "Game" and savedLighting and savedLighting.ClockTime then
        Lighting.ClockTime = savedLighting.ClockTime
    end
    applyLightingValues()
    status.Text = "Status: " .. mode .. " mode. Shadows on for you, held items and objects." .. windStatus()
end

local function setMode(index)
    modeIndex = index
    refreshModeButtons()
    if enabled then applyMode() end
end

for i, b in ipairs(modeButtons) do
    b.MouseButton1Click:Connect(function() setMode(i) end)
end

local function setShader(value)
    enabled = value
    if enabled then
        saveLighting()
        pcall(function() sethiddenproperty(Lighting, "Technology", Enum.Technology.Future) end)
        enableEffects()
        applyCharacterShadow(localPlayer.Character)
        watchCharacter(localPlayer.Character)
        startWorldShadows()
        startWind()
        applyMode()
        shaderButton.Text = "Shader OFF"
        shaderButton.BackgroundColor3 = COLOR_OFF
    else
        disableEffects()
        restoreLighting()
        shaderButton.Text = "Shader ON"
        shaderButton.BackgroundColor3 = COLOR_ON
        status.Text = "Status: off, original lighting restored"
    end
end

shaderButton.MouseButton1Click:Connect(function()
    setShader(not enabled)
end)

local characterConnection = localPlayer.CharacterAdded:Connect(function(character)
    task.wait(0.5)
    if enabled and character.Parent then
        applyCharacterShadow(character)
        watchCharacter(character)
    end
end)

local renderConnection = RunService.RenderStepped:Connect(updateContactShadow)

task.spawn(function()
    local last = os.clock()
    while alive do
        task.wait(0.1)
        local now = os.clock()
        local dt = now - last
        last = now
        if enabled then
            if MODES[modeIndex] == "Cycle" then
                Lighting.ClockTime = (Lighting.ClockTime + CONFIG.CycleSpeed * dt) % 24
            end
            pcall(applyLightingValues) -- colors follow the clock, so sunrise/sunset glow updates live
            pcall(updateWind)
        end
    end
end)

task.spawn(function()
    while alive do
        task.wait(CONFIG.ReapplyInterval)
        if enabled then
            pcall(applyCharacterShadow, localPlayer.Character)
            local clock = fixedClockTime(MODES[modeIndex])
            if clock then
                pcall(function() Lighting.ClockTime = clock end)
            end
            if windWorks ~= nil and modeIndex then
                -- refresh the status once the first wind attempt is known
                local mode = MODES[modeIndex]
                status.Text = "Status: " .. mode .. " mode. Shadows on for you, held items and objects."
                    .. windStatus()
            end
        end
    end
end)

closeButton.MouseButton1Click:Connect(function()
    alive = false
    if enabled then setShader(false) end
    characterConnection:Disconnect()
    renderConnection:Disconnect()
    screenGui:Destroy()
end)
