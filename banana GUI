---------------------------------------------------------
-- 色を動的に変更するための管理リスト
---------------------------------------------------------
local updateBorderColorFuncs = {}
local updateTextColorFuncs = {}

local function applyBorderColor(newColor)
	BORDER_COLOR = newColor
	mainStroke.Color = newColor
	for _, fn in ipairs(updateBorderColorFuncs) do
		pcall(fn, newColor)
	end
end

local function applyTextColor(newColor)
	for _, fn in ipairs(updateTextColorFuncs) do
		pcall(fn, newColor)
	end
end

---------------------------------------------------------
-- 虹色アニメーション
---------------------------------------------------------
local isRainbow = true
local rainbowConnection = nil

local function startRainbow()
	if rainbowConnection then return end
	rainbowConnection = RunService.Heartbeat:Connect(function()
		if not isRainbow then return end
		local hue = (tick() * 0.5) % 1
		local c = Color3.fromHSV(hue, 1, 1)
		applyBorderColor(c)
		applyTextColor(c)
	end)
end

local function stopRainbow()
	if rainbowConnection then
		rainbowConnection:Disconnect()
		rainbowConnection = nil
	end
end

startRainbow()

