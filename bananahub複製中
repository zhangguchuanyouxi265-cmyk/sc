local GrabEvents = ReplicatedStorage:WaitForChild("GrabEvents")
local createLineRemote = GrabEvents:WaitForChild("CreateGrabLine")

local lagMultiplier = 10
local running = false
local lagTask = nil

local function StartLag()
	if running then return end
	running = true
	lagTask = task.spawn(function()
		while running do
			local spawnLocation = Workspace:FindFirstChild("SpawnLocation")
				or Workspace:FindFirstChild("Spawn")
				or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))

			if spawnLocation then
				for _ = 1, lagMultiplier do
					createLineRemote:FireServer(
						spawnLocation,
						CFrame.new(
							math.random(-2010000000, 2000000001),
							0,
							math.random(-2008100000, 2000200000)
						)
					)
				end
			end
			task.wait()
		end
	end)
end

local function StopLag()
	running = false
	if lagTask then
		pcall(task.cancel, lagTask)
		lagTask = nil
	end
end

local lagStatus = createLabel(lagTab.page, "Status: OFF | Multiplier: 10", 1)

createLabel(lagTab.page, "Lag Multiplier (1-10)", 2)
local lagMultiplierBox = createNumberBox(lagTab.page, "e.g. 10", 3)

createButton(lagTab.page, "Set Lag Multiplier", 4, function()
	local num = tonumber(lagMultiplierBox.Text)
	if not num or num ~= num or num < 1 then
		lagStatus.Text = "Invalid multiplier value!"
		return
	end
	lagMultiplier = math.clamp(math.floor(num), 1, 10)
	lagStatus.Text = string.format("Status: %s | Multiplier: %d",
		running and "ON" or "OFF", lagMultiplier)
	print("[Lag] Multiplier set to", lagMultiplier)
end)

local lagToggleBtn
lagToggleBtn = createButton(lagTab.page, "Toggle Lag (OFF)", 5, function()
	if running then
		StopLag()
	else
		local ok, err = pcall(StartLag)
		if not ok then
			lagStatus.Text = "Error: " .. tostring(err)
			warn("[Lag] Error:", err)
			return
		end
	end

	lagToggleBtn.Text = string.format("Toggle Lag (%s)", running and "ON" or "OFF")
	lagStatus.Text = string.format("Status: %s | Multiplier: %d",
		running and "ON" or "OFF", lagMultiplier)
	print("[Lag] Running =", running)
end)

