local tabs = {}
local activeTab = nil

local function createTab(name, layoutOrder)
	local tabBtn = Instance.new("TextButton")
	tabBtn.Name = name .. "Tab"
	tabBtn.Size = UDim2.new(1, 0, 0, 32)
	tabBtn.BackgroundColor3 = PANEL_COLOR
	tabBtn.BackgroundTransparency = BG_TRANSPARENCY
	tabBtn.Text = name
	tabBtn.TextColor3 = TEXT_COLOR
	tabBtn.TextSize = 13
	tabBtn.Font = Enum.Font.GothamBlack
	tabBtn.TextXAlignment = Enum.TextXAlignment.Left
	tabBtn.LayoutOrder = layoutOrder or (#tabs + 1)
	tabBtn.Parent = tabBar
	table.insert(updateTextColorFuncs, function(c) tabBtn.TextColor3 = c end)

	local tabStroke = Instance.new("UIStroke")
	tabStroke.Color = BORDER_COLOR
	tabStroke.Thickness = 1
	tabStroke.Transparency = 0.5
	tabStroke.Parent = tabBtn
	table.insert(updateBorderColorFuncs, function(c) tabStroke.Color = c end)

	local tabCorner = Instance.new("UICorner")
	tabCorner.CornerRadius = UDim.new(0, 4)
	tabCorner.Parent = tabBtn

	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.Parent = tabBtn

	local page = Instance.new("ScrollingFrame")
	page.Name = name .. "Page"
	page.Size = UDim2.new(1, -12, 1, -12)
	page.Position = UDim2.new(0, 6, 0, 6)
	page.BackgroundTransparency = 1
	page.BorderSizePixel = 0
	page.ScrollBarThickness = 4
	page.ScrollBarImageColor3 = BORDER_COLOR
	page.CanvasSize = UDim2.new(0, 0, 0, 0)
	page.AutomaticCanvasSize = Enum.AutomaticSize.Y
	page.Visible = false
	page.Parent = contentFrame
	table.insert(updateBorderColorFuncs, function(c) page.ScrollBarImageColor3 = c end)

	local pageLayout = Instance.new("UIListLayout")
	pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
	pageLayout.Padding = UDim.new(0, 8)
	pageLayout.Parent = page

	local pagePad = Instance.new("UIPadding")
	pagePad.PaddingTop = UDim.new(0, 6)
	pagePad.PaddingBottom = UDim.new(0, 6)
	pagePad.PaddingLeft = UDim.new(0, 8)
	pagePad.PaddingRight = UDim.new(0, 8)
	pagePad.Parent = page

	local tab = { name = name, button = tabBtn, page = page, stroke = tabStroke }
	table.insert(tabs, tab)

	tabBtn.MouseButton1Click:Connect(function()
		for _, t in ipairs(tabs) do
			t.page.Visible = false
			t.stroke.Transparency = 0.5
			t.button.BackgroundTransparency = BG_TRANSPARENCY
		end
		page.Visible = true
		tabStroke.Transparency = 0
		tabBtn.BackgroundTransparency = 0
		activeTab = tab
	end)

	return tab
end

