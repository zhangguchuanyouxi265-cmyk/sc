createButton(grabTab.page, "Activate Anti-Kick", 2, function()
	if antiKickActive then
		grabStatus.Text = "Status: Already active"
		return
	end
	antiKickActive = true
	grabStatus.Text = "Status: Activating..."

	if type(hookfunction) == "function" then
		pcall(function()
			hookfunction(game.Players.LocalPlayer.Kick, function(self, msg)
				warn("[Anti-Kick] Kick blocked:", msg)
			end)
		end)
	end

	pcall(function()
		game:GetService("Players").LocalPlayer.OnTeleport:Connect(function()
			warn("[Anti-Kick] Teleport event detected")
		end)
	end)

	if type(hookmetamethod) == "function" and type(getnamecallmethod) == "function" then
		pcall(function()
			local oldNamecall
			oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
				local method = getnamecallmethod()
				if method == "Kick" then
					warn("[Anti-Kick] namecall Kick blocked")
					return
				end
				return oldNamecall(self, ...)
			end)
		end)
	end

	grabStatus.Text = "Status: Active (Anti-Kick enabled)"
	print("[Anti-Kick] All protections activated.")
end)

