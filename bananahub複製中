-- TAB 1: Speed
---------------------------------------------------------
local speedTab = createTab("Speed", 1)

createLabel(speedTab.page, "Walk Speed", 1)
local speedBox = createNumberBox(speedTab.page, "e.g. 50", 2)
local speedStatus = createLabel(speedTab.page, "Current: -", 3)

local targetWalkSpeed = nil
local walkLoopConn = nil

local function startWalkLoop()
	if walkLoopConn then return end
	walkLoopConn = RunService.Heartbeat:Connect(function()
		if targetWalkSpeed == nil then return end
		local hum = getHumanoid()
		if hum and hum.WalkSpeed ~= targetWalkSpeed then
			hum.WalkSpeed = targetWalkSpeed
		end
	end)
end

createButton(speedTab.page, "Apply Walk Speed", 4, function()
	local num = tonumber(speedBox.Text)
	if not num or num ~= num or num < 0 then
		speedStatus.Text = "Invalid input!"
		return
	end
	local hum = getHumanoid()
	if not hum then
		speedStatus.Text = "Humanoid not found!"
		return
	end
	targetWalkSpeed = num
	hum.WalkSpeed = num
	startWalkLoop()
	speedStatus.Text = string.format("WalkSpeed = %.1f (locked)", num)
end)

createLabel(speedTab.page, "Jump Power", 5)
local jumpBox = createNumberBox(speedTab.page, "e.g. 100", 6)
local jumpStatus = createLabel(speedTab.page, "Current: -", 7)

local targetJumpPower = nil
local jumpLoopConn = nil

local function startJumpLoop()
	if jumpLoopConn then return end
	jumpLoopConn = RunService.Heartbeat:Connect(function()
		if targetJumpPower == nil then return end
		local hum = getHumanoid()
		if not hum then return end
		if not hum.UseJumpPower then hum.UseJumpPower = true end
		if hum.JumpPower ~= targetJumpPower then hum.JumpPower = targetJumpPower end
	end)
end

createButton(speedTab.page, "Apply Jump Power", 8, function()
	local num = tonumber(jumpBox.Text)
	if not num or num ~= num or num < 0 then
		jumpStatus.Text = "Invalid input!"
		return
	end
	local hum = getHumanoid()
	if not hum then
		jumpStatus.Text = "Humanoid not found!"
		return
	end
	targetJumpPower = num
	hum.UseJumpPower = true
	hum.JumpPower = num
	startJumpLoop()
	jumpStatus.Text = string.format("JumpPower = %.1f (locked)", num)
end)

RunService.Heartbeat:Connect(function()
	local hum = getHumanoid()
	if hum then
		if targetWalkSpeed then
			speedStatus.Text = string.format("WalkSpeed = %.1f / %s", hum.WalkSpeed, tostring(targetWalkSpeed))
		end
		if targetJumpPower then
			jumpStatus.Text = string.format("JumpPower = %.1f / %s", hum.JumpPower, tostring(targetJumpPower))
		end
	end
end)

