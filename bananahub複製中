local function RunAntiGrabLoop()
    local Char = LocalPlayer.Character
    if not Char then return end
    local Root = Char:FindFirstChild("HumanoidRootPart")
    local Hum = Char:FindFirstChildOfClass("Humanoid")
    if not Root or not Hum then return end

    task.spawn(function()
        while antiGrabV2Active and isHeld and isHeld.Value do
            if not IsPlayerCurrentlyGrabbing() then
                for _, part in pairs(Char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
                pcall(function()
                    local ce = ReplicatedStorage:FindFirstChild("CharacterEvents")
                    local st = struggleEvent or (ce and ce:FindFirstChild("Struggle"))
                    if st then st:FireServer() end
                    local rr = ce and ce:FindFirstChild("RagdollRemote")
                    if rr and Root then rr:FireServer(Root, 0) end
                end)
            end
            task.wait()
        end
    end)

    task.spawn(function()
        while antiGrabV2Active and isHeld and isHeld.Value do
            if IsPlayerCurrentlyGrabbing() then
                if Root and Root.Anchored then
                    Root.Anchored = false
                end
            else
                pcall(function()
                    Hum.Sit = false
                    Hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                    Hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                    if Root then
                        Root.Anchored = true
                        Root.AssemblyLinearVelocity = Vector3.zero
                        Root.AssemblyAngularVelocity = Vector3.zero
                    end
                end)
            end
            task.wait()
        end
        if Root then Root.Anchored = false end
        if Char then
            for _, part in pairs(Char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = true
                end
            end
        end
    end)
end

