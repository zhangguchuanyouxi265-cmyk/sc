-- Kickトグル
---------------------------------------------------------
local kickToggleBtn
kickToggleBtn = createButton(kickTab.page, "Toggle Kick (OFF)", 10, function()
	if ENABLE_KICK then
		-- ===== 停止 =====
		ENABLE_KICK = false
		aa6 = false
		aa12.aa13 = false

		if kickTask then
			pcall(task.cancel, kickTask)
			kickTask = nil
		end

		if TARGET_NAME and TARGET_NAME ~= "" then
			local target = aa21(TARGET_NAME)
			if target and target.Character then
				local hrp = target.Character:FindFirstChild("HumanoidRootPart")
				if hrp and hrp:FindFirstChild("ControlBP") then
					hrp.ControlBP:Destroy()
				end
			end
		end

		if aa16["aa73"] then
			pcall(function() aa16["aa73"]:Disconnect() end)
			aa16["aa73"] = nil
		end

		if aa72List[1] and aa72List[1]:IsDescendantOf(workspace) then
			pcall(function() aa72List[1]:Destroy() end)
			aa72List[1] = nil
		end

		kickToggleBtn.Text = "Toggle Kick (OFF)"
		kickStatus.Text = string.format("Status: OFF | Target: %s | Lag: %s",
			TARGET_NAME or "(none)", ENABLE_LAG and "ON" or "OFF")
		print("[Kick] Stopped")
	else
		-- ===== 開始 =====
		if not TARGET_NAME or TARGET_NAME == "" then
			kickStatus.Text = "Select a player first!"
			return
		end

		ENABLE_KICK = true
		aa6 = true
		aa12.aa13 = true

		-- ラグがOFFならONにする
		if not ENABLE_LAG then
			startLagSpamKick()
			lagOnlyBtn.Text = "Toggle Lag Only (ON)"
		end

		kickTask = task.spawn(function()
			while aa6 do
				local targetDisplay = TARGET_NAME
				if targetDisplay and targetDisplay ~= "" then
					local target = aa21(targetDisplay)
					local myChar = LocalPlayer.Character
					local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
					if target and myHrp then
						local tChar = target.Character
						local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
						if tHrp then
							local dist = (myHrp.Position - tHrp.Position).Magnitude
							if dist > aa9 then aa25(target, myHrp) end
							aa11:FireServer(tHrp, tHrp.CFrame)
							if GrabEvents:FindFirstChild("DestroyGrabLine") then
								GrabEvents.DestroyGrabLine:FireServer(tHrp)
							end
							tHrp.AssemblyLinearVelocity = Vector3.zero
							tHrp.AssemblyAngularVelocity = Vector3.zero
							local bp = tHrp:FindFirstChild("ControlBP")
							if not bp then
								bp = Instance.new("BodyPosition")
								bp.Name = "ControlBP"
								bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
								bp.P = 800000
								bp.Parent = tHrp
							end
							bp.Position = myHrp.Position + Vector3.new(0, HEIGHT_ABOVE, 0)
						end
					end
				end
				task.wait()
			end
		end)

		aa16["aa73"] = RunService.RenderStepped:Connect(function()
			if not aa12.aa13 then return end
			local targetName = aa14.aa15[1]
			if not targetName then
				if aa72List[1] and aa72List[1]:IsDescendantOf(workspace) then
					aa72List[1]:Destroy(); aa72List[1] = nil
				end
				return
			end
			local target = Players:FindFirstChild(targetName)
			if not target or not target.Character then
				if aa72List[1] and aa72List[1]:IsDescendantOf(workspace) then
					aa72List[1]:Destroy(); aa72List[1] = nil
				end
				return
			end
			local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
			local tHum = target.Character:FindFirstChild("Humanoid")
			if not tHrp or not tHum then return end
			local pallet = aa72List[1]
			if pallet and pallet:IsDescendantOf(workspace) then
				local soundPart = pallet:FindFirstChild("SoundPart")
				if soundPart then
					if not aa37(soundPart, "PartOwner") then
						pallet:Destroy(); aa72List[1] = nil
					end
				else
					pallet:Destroy(); aa72List[1] = nil
				end
			end
			if not aa17 and (not aa72List[1] or not aa72List[1]:IsDescendantOf(workspace)) then
				aa72List[1] = aa50(1)
			end
			if aa72List[1] and aa72List[1]:IsDescendantOf(workspace) then
				local soundPart = aa72List[1]:FindFirstChild("SoundPart")
				if soundPart then
					soundPart.Position = tHrp.Position
					soundPart.AssemblyLinearVelocity = Vector3.zero
					soundPart.AssemblyAngularVelocity = Vector3.zero
					local bv = soundPart:FindFirstChildOfClass("BodyVelocity")
					if bv then
						if bv.Velocity.Y ~= 900 then
							bv.Velocity = Vector3.new(0, 900, 0)
						end
					else
						local newBv = Instance.new("BodyVelocity")
						newBv.MaxForce = Vector3.new(0, math.huge, 0)
						newBv.Velocity = Vector3.new(0, 900, 0)
						newBv.Parent = soundPart
					end
				end
			end
		end)

		kickToggleBtn.Text = "Toggle Kick (ON)"
		kickStatus.Text = string.format("Status: ON | Target: %s | Lag: %s",
			TARGET_NAME, ENABLE_LAG and "ON" or "OFF")
		print("[Kick] Started, target =", TARGET_NAME)
	end
end)

