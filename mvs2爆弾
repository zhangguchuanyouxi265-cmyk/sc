-- 4. 爆弾風シェーダー（画面ポストプロセス + 火薬・爆風演出）
-- ============================================================
local BombShader = {
    ColorCorrection = nil,
    Bloom = nil,
    SunRays = nil,
}

local function cleanupBombShader()
    if BombShader.ColorCorrection then BombShader.ColorCorrection:Destroy() BombShader.ColorCorrection = nil end
    if BombShader.Bloom then BombShader.Bloom:Destroy() BombShader.Bloom = nil end
    if BombShader.SunRays then BombShader.SunRays:Destroy() BombShader.SunRays = nil end
end

local function enableBombShader()
    cleanupBombShader()

    -- 爆弾の火薬・灼熱トーン（赤み・暖色強調＋煙のコントラスト）
    local cc = Instance.new("ColorCorrectionEffect")
    cc.Name = "MVS2_BombShader_CC"
    cc.TintColor = Color3.fromRGB(255, 224, 196)
    cc.Contrast = 0.14
    cc.Saturation = 0.18
    cc.Brightness = 0.02
    cc.Parent = Lighting
    BombShader.ColorCorrection = cc

    -- 導火線の火花や爆発光が滲むブルーム
    local bloom = Instance.new("BloomEffect")
    bloom.Name = "MVS2_BombShader_Bloom"
    bloom.Intensity = 0.85
    bloom.Size = 28
    bloom.Threshold = 0.85
    bloom.Parent = Lighting
    BombShader.Bloom = bloom

    -- 爆風・閃光のサンレイ演出
    local rays = Instance.new("SunRaysEffect")
    rays.Name = "MVS2_BombShader_SunRays"
    rays.Intensity = 0.16
    rays.Spread = 0.65
    rays.Parent = Lighting
    BombShader.SunRays = rays
end

local function pulseBombShader(strength)
    TriggerBotController.BlastPulse = math.max(TriggerBotController.BlastPulse, strength or 1.0)
end

local function updateBombShader()
    if not TriggerBotCfg.Enabled then
        cleanupBombShader()
        return
    end
    if not BombShader.ColorCorrection or not BombShader.ColorCorrection.Parent then
        enableBombShader()
    end

    TriggerBotController.BlastPulse = math.max(0, TriggerBotController.BlastPulse - RunService.RenderStepped:Wait() * 2.8)
    local pulse = TriggerBotController.BlastPulse
    local flicker = math.sin(tick() * 24) * 0.08 + math.cos(tick() * 13) * 0.05

    if BombShader.ColorCorrection then
        BombShader.ColorCorrection.TintColor = Color3.fromRGB(
            255,
            math.clamp(222 - math.floor(pulse * 45), 150, 255),
            math.clamp(192 - math.floor(pulse * 75), 110, 255)
        )
        BombShader.ColorCorrection.Contrast = 0.14 + (pulse * 0.22) + (flicker * 0.05)
        BombShader.ColorCorrection.Brightness = 0.02 + (pulse * 0.14)
    end
    if BombShader.Bloom then
        BombShader.Bloom.Intensity = 0.85 + (pulse * 1.35) + flicker
    end
    if BombShader.SunRays then
        BombShader.SunRays.Intensity = 0.16 + (pulse * 0.35)
    end
end

