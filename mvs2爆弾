-- 10. メインループ（敵発見で自動銃構え＆胴体狙い発射）
-- ============================================================
RunService.Heartbeat:Connect(function()
    updateHeldBomb()
    updateBombShader()

    if not TriggerBotController.Patched then return end
    if not TriggerBotCfg.Enabled then
        silentController.TargetPos = nil
        return
    end

    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    local targetChar = nil

    if TriggerBotCfg.Mode == "Center" then
        local vp = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        local unitRay = camera:ViewportPointToRay(vp.X, vp.Y)
        local rayResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000)
        if rayResult and rayResult.Instance then
            local model = rayResult.Instance:FindFirstAncestorOfClass("Model")
            if model and model:FindFirstChild("Humanoid") and model ~= char then
                local plr = Players:GetPlayerFromCharacter(model)
                if (not plr or isEnemy(plr)) then
                    local torso = GetTorsoPart(model)
                    if torso and (not TriggerBotCfg.WallCheck or RaycastCheck(torso)) then
                        targetChar = model
                    end
                end
            end
        end
    elseif TriggerBotCfg.Mode == "Visible" then
        local targetPlr = GetBestTarget()
        if targetPlr and targetPlr.Character then
            targetChar = targetPlr.Character
        end
    end

    if targetChar then
        local hum = targetChar:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            -- 敵を発見したら自動で銃を構える
            ensureGunEquipped()
            StatusLabel.Text = "ステータス: 敵発見！銃を構えて胴体狙い中"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 140, 50)

            if (tick() - TriggerBotController.LastShootTime) >= TriggerBotController.CoolDown then
                if targetChar ~= TriggerBotController.ReactionTarget then
                    TriggerBotController.ReactionTarget = targetChar
                    TriggerBotController.ReactionStartTime = tick()
                end
                local delaySec = TriggerBotCfg.ReactionDelay / 10
                if (tick() - TriggerBotController.ReactionStartTime) >= delaySec then
                    task.spawn(function()
                        FireAutoTrigger(targetChar)
                    end)
                    TriggerBotController.ReactionTarget = nil
                end
            end
        end
    else
        silentController.TargetPos = nil
        StatusLabel.Text = "ステータス: 敵探索中（爆弾シェーダーON）"
        StatusLabel.TextColor3 = Color3.fromRGB(215, 175, 130)
        TriggerBotController.ReactionTarget = nil
    end
end)

