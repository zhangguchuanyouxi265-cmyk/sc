        enableBombShader()
        ActionBtn.Text = "爆弾Bot + シェーダー (ON)"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(210, 95, 25)
        StatusLabel.Text = "ステータス: 起動中（リスポーン）"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 165, 65)
    end
end

player.CharacterAdded:Connect(onCharacterAdded)
if player.Character then onCharacterAdded(player.Character) end

