local function isEnemy(p)
    if p == player then return false end
    if p.Team == player.Team then return TeamKillEnabled end
    return true
end

-- 頭ではなく胴体（UpperTorso / Torso / HumanoidRootPart）を取得
local function GetTorsoPart(character)
    if not character then return nil end
    return character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("HumanoidRootPart")
end

-- 胴体を中心に少しだけランダム位置を返す
local function GetTorsoAimPoint(character)
    local torso = GetTorsoPart(character)
    if not torso then return nil end

    local spread = TriggerBotCfg.TorsoSpread
    local offset = Vector3.new(
        (math.random() * 2 - 1) * spread,
        (math.random() * 2 - 1) * spread,
        (math.random() * 2 - 1) * spread
    )
    return torso.Position + offset
end

local function RaycastCheck(target)
    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not hrp then return false end

    local targetPos = typeof(target) == "Instance"
        and (target:IsA("BasePart") and target.Position or target:GetPivot().Position)
        or target
    local targetChar = typeof(target) == "Instance"
        and target:FindFirstAncestorOfClass("Model") or nil

    local origin = hrp.Position
    local params = RaycastParams.new()
    local ignore = {character}
    if targetChar then table.insert(ignore, targetChar) end
    params.FilterDescendantsInstances = ignore
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true

    local cur = origin
    for _ = 1, 3 do
        local dir = targetPos - cur
        if dir.Magnitude < 0.1 then return true end
        local result = workspace:Raycast(cur, dir, params)
        if not result then return true end
        local hit = result.Instance
        if hit.CanCollide and hit.Name ~= "Decoration" and hit.Transparency < 0.9 then
            return false
        else
            table.insert(ignore, hit)
            params.FilterDescendantsInstances = ignore
            cur = result.Position + (dir.Unit * 0.05)
        end
    end
    return false
end

local function GetBestTarget()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local myRoot = character.HumanoidRootPart
    local closestDist, targetPlayer = math.huge, nil

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            if isEnemy(p) then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local torso = GetTorsoPart(p.Character) or p.Character.HumanoidRootPart
                    local dist = (myRoot.Position - torso.Position).Magnitude
                    if dist <= TriggerBotCfg.MaxDistance then
                        if not TriggerBotCfg.WallCheck or RaycastCheck(torso) then
                            if dist < closestDist then
                                closestDist = dist
                                targetPlayer = p
                            end
                        end
                    end
                end
            end
        end
    end
    return targetPlayer
end

