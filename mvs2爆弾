local function createBombModel(scale)
    scale = scale or 1
    local model = Instance.new("Model")
    model.Name = "BombModel"

    local body = Instance.new("Part")
    body.Name = "Body"
    body.Shape = Enum.PartType.Ball
    body.Size = Vector3.new(1.5, 1.5, 1.5) * scale
    body.Color = Color3.fromRGB(25, 25, 30)
    body.Material = Enum.Material.SmoothPlastic
    body.CanCollide = false
    body.Anchored = true
    body.Parent = model

    local cap = Instance.new("Part")
    cap.Name = "Cap"
    cap.Size = Vector3.new(0.55, 0.32, 0.55) * scale
    cap.Color = Color3.fromRGB(110, 95, 85)
    cap.Material = Enum.Material.Metal
    cap.CanCollide = false
    cap.Anchored = true
    cap.Parent = model

    local fuse = Instance.new("Part")
    fuse.Name = "Fuse"
    fuse.Size = Vector3.new(0.16, 0.6, 0.16) * scale
    fuse.Color = Color3.fromRGB(255, 150, 30)
    fuse.Material = Enum.Material.Neon
    fuse.CanCollide = false
    fuse.Anchored = true
    fuse.Parent = model

    local spark = Instance.new("PointLight")
    spark.Color = Color3.fromRGB(255, 120, 20)
    spark.Range = 9 * scale
    spark.Brightness = 3
    spark.Parent = fuse

    model.PrimaryPart = body
    model.Parent = BombFolder
    return model
end

local function positionBombModel(model, cframe)
    if not model or not model.PrimaryPart then return end
    local scale = model.PrimaryPart.Size.X / 1.5
    model.PrimaryPart.CFrame = cframe
    local cap = model:FindFirstChild("Cap")
    local fuse = model:FindFirstChild("Fuse")
    if cap then
        cap.CFrame = cframe * CFrame.new(0, 0.8 * scale, 0)
    end
    if fuse then
        fuse.CFrame = cframe * CFrame.new(0.15 * scale, 1.08 * scale, 0) * CFrame.Angles(0, 0, math.rad(-25))
    end
end

local function getHandCFrame()
    local character = player.Character
    if not character then return nil end
    local hand = character:FindFirstChild("LeftHand")
        or character:FindFirstChild("Left Arm")
        or character:FindFirstChild("RightHand")
        or character:FindFirstChild("Right Arm")
    if hand then
        return hand.CFrame * CFrame.new(0, -0.4 * hand.Size.Y, -0.3)
    end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp then
        return hrp.CFrame * CFrame.new(-1.3, 0.2, -0.8)
    end
    return nil
end

local function updateHeldBomb()
    if not TriggerBotCfg.Enabled then
        if heldBombModel then heldBombModel:Destroy() heldBombModel = nil end
        return
    end
    local handCF = getHandCFrame()
    if not handCF then
        if heldBombModel then heldBombModel:Destroy() heldBombModel = nil end
        return
    end
    if not heldBombModel or not heldBombModel.PrimaryPart or not heldBombModel.Parent then
        heldBombModel = createBombModel(0.95)
    end
    positionBombModel(heldBombModel, handCF * CFrame.Angles(tick() * 2, tick() * 3, 0))
end

local function triggerExplosionEffect(pos)
    pulseBombShader(1.0)

    local exp = Instance.new("Explosion")
    exp.Position = pos
    exp.BlastRadius = 11
    exp.BlastPressure = 0
    exp.DestroyJointRadiusPercent = 0
    exp.Parent = workspace

    local flash = Instance.new("Part")
    flash.Shape = Enum.PartType.Ball
    flash.Size = Vector3.new(1, 1, 1)
    flash.Color = Color3.fromRGB(255, 115, 20)
    flash.Material = Enum.Material.Neon
    flash.Transparency = 0.15
    flash.Anchored = true
    flash.CanCollide = false
    flash.CFrame = CFrame.new(pos)
    flash.Parent = BombFolder

    TweenService:Create(
        flash,
        TweenInfo.new(0.38, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {Size = Vector3.new(12, 12, 12), Transparency = 1}
    ):Play()
    Debris:AddItem(flash, 0.42)
end

local function ThrowBombOnKill(targetPosition)
    if not targetPosition then return end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local startCF = getHandCFrame() or (hrp and (hrp.CFrame * CFrame.new(-1, 1, -1)))
    if not startCF then return end

    local thrownBomb = createBombModel(1.15)
    local startPos = startCF.Position
    local endPos = targetPosition
    local dist = (endPos - startPos).Magnitude
    local arcHeight = math.clamp(dist * 0.28 + 3.5, 4, 18)
    local duration = math.clamp(dist / 75, 0.22, 0.55)
    local t0 = tick()

    StatusLabel.Text = "ステータス: 撃破！爆弾投擲中..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 120, 35)

    local conn
    conn = RunService.RenderStepped:Connect(function()
        local alpha = math.clamp((tick() - t0) / duration, 0, 1)
        local linearPos = startPos:Lerp(endPos, alpha)
        local parabolaY = 4 * arcHeight * alpha * (1 - alpha)
        local currentPos = Vector3.new(linearPos.X, linearPos.Y + parabolaY, linearPos.Z)

        local rot = CFrame.Angles(alpha * math.pi * 6, alpha * math.pi * 4, 0)
        positionBombModel(thrownBomb, CFrame.new(currentPos) * rot)

        if alpha >= 1 then
            conn:Disconnect()
            triggerExplosionEffect(currentPos)
            if thrownBomb then thrownBomb:Destroy() end
        end
    end)
end

local function monitorEnemyKills()
    task.spawn(function()
        while true do
            task.wait(0.05)
            if TriggerBotCfg.Enabled then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= player and isEnemy(p) and p.Character then
                        local hum = p.Character:FindFirstChildOfClass("Humanoid")
                        local torso = GetTorsoPart(p.Character)
                        local lastPos = torso and torso.Position or nil

                        local prevAlive = silentController.TrackedEnemies[p]
                        local nowAlive = (hum and hum.Health > 0) and true or false

                        if prevAlive and not nowAlive and lastPos then
                            local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                            if not myRoot or (myRoot.Position - lastPos).Magnitude <= TriggerBotCfg.MaxDistance then
                                task.spawn(function()
                                    ThrowBombOnKill(lastPos)
                                end)
                            end
                        end
                        silentController.TrackedEnemies[p] = nowAlive
                    end
                end
            end
        end
    end)
end
monitorEnemyKills()

