-- 8. 発射処理（自動で銃を構えて胴体へ発射）
-- ============================================================
local function FireAutoTrigger(targetChar)
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end

    local equipped = ensureGunEquipped()
    if equipped and (tick() - TriggerBotController.EquipTime) < 0.08 then
        task.wait(0.08)
    end

    local aimPos = GetTorsoAimPoint(targetChar)
    if not aimPos then return end
    silentController.TargetPos = aimPos
    pulseBombShader(0.35)

    if Device.InputMode == "Console" then
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.ButtonR2, false, game)
        task.wait(0.04)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.ButtonR2, false, game)
    else
        VirtualInputManager:SendMouseButtonEvent(
            camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2,
            0, true, game, 1
        )
        task.wait(0.04)
        VirtualInputManager:SendMouseButtonEvent(
            camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2,
            0, false, game, 1
        )
    end

    TriggerBotController.LastShootTime = tick()
    StatusLabel.Text = "ステータス: 銃を構えて胴体へ発射！"
    StatusLabel.TextColor3 = Color3.fromRGB(255, 165, 55)
end

