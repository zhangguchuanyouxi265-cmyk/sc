local function tryHookSilentAim()
    if type(hookfunction) ~= "function" then return false end
    local ok, CombatClient = pcall(function() return require(game.ReplicatedStorage.Client.Madwork.CombatClient) end)
    if not ok or not CombatClient then return false end

    local oldNewLocalEvent
    oldNewLocalEvent = hookfunction(CombatClient.NewLocalEvent, function(data)
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not character or not hrp then return oldNewLocalEvent(data) end

        if TriggerBotCfg.Enabled and silentController.TargetPos and data and typeof(data) == "table" then
            local myPos = hrp.Position
            local dirVec = silentController.TargetPos - myPos
            if dirVec.Magnitude > 0.05 then
                data.Position = myPos
                data.Direction = dirVec.Unit
            end
        end
        return oldNewLocalEvent(data)
    end)
    return true
end

tryHookSilentAim()

