        if #x < 6 then return '' end
        local c = 0
        for i = 1, 6 do c = c + (x:sub(i,i) == '1' and 2^(6-i) or 0) end
        return _B64:sub(c+1, c+1)
    end) .. ({'', '==', '='})[#data % 3 + 1])
end

local function _b64d(data)
    data = data:gsub('[^' .. _B64 .. '=]', '')
    return (data:gsub('.', function(x)
        if x == '=' then return '' end
        local r, f = '', (_B64:find(x) - 1)
        for i = 6, 1, -1 do r = r .. (f % 2^i - f % 2^(i-1) > 0 and '1' or '0') end
        return r
    end):gsub('%d%d%d?%d?%d?%d?%d?%d?', function(x)
        if #x ~= 8 then return '' end
        local c = 0
        for i = 1, 8 do c = c + (x:sub(i,i) == '1' and 2^(8-i) or 0) end
        return string.char(c)
    end))
end

local function _esc(s) return (s:gsub('.', function(c) return string.format('\\x%02x', c:byte()) end)) end
local function _unex(s) return (s:gsub('\\x(%x%x)', function(h) return string.char(tonumber(h, 16)) end)) end

local function _chunk(str, seed)
    math.randomseed(seed)
    local out, i = {}, 1
    while i <= #str do
        local n = math.random(20, 45)
        out[#out+1] = str:sub(i, i + n - 1)
        i = i + n
    end
    return out
end

local function _run()
    local key = _deriveKey(MY_USERID)
    local xored = _xor(RAW_CODE, key)
    local b64 = _b64e(xored)
    local chunks = _chunk(b64, 42)
    local double = {}
    for i, c in ipairs(chunks) do double[i] = _b64e(c) end
    local escaped = {}
    for i, c in ipairs(double) do escaped[i] = _esc(c) end

    local decoded_chunks = {}
    for i, c in ipairs(escaped) do decoded_chunks[i] = _b64d(_unex(c)) end
    local decoded = _xor(_b64d(table.concat(decoded_chunks)), key)

    local fn, err = loadstring(decoded)
    if fn then
        local ok, e = pcall(fn)
        if not ok then warn("[PHANTOM] runtime: " .. tostring(e)) end
    else
        warn("[PHANTOM] compile: " .. tostring(err))
    end
end

_run()
