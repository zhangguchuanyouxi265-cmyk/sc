local function RaycastCheck(target)
    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not hrp then return false end
    local targetPos = typeof(target) == "Instance" and (target:IsA("BasePart") and target.Position or target:GetPivot().Position) or target
    local targetChar = typeof(target) == "Instance" and target:FindFirstAncestorOfClass("Model") or nil
    local origin = hrp.Position
    local params = RaycastParams.new()
    local ignore = {character}
    if targetChar then table.insert(ignore, targetChar) end
    params.FilterDescendantsInstances = ignore
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    local cur = origin
    for _ = 1, 3 do
        local dir = targetPos - cur
        if dir.Magnitude < 0.1 then return true end
        local result = workspace:Raycast(cur, dir, params)
        if not result then return true end
        local hit = result.Instance
        if hit.CanCollide and hit.Name ~= "Decoration" and hit.Transparency < 0.9 then return false
        else table.insert(ignore, hit); params.FilterDescendantsInstances = ignore; cur = result.Position + (dir.Unit * 0.05) end
    end
    return false
end

