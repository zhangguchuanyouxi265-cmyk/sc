local function _deriveKey(uid)
    local salt = "\x9f\x2a\x7c\x11\xe3\x55\xb8\x0d\x4c\x91\xa2\x3f\x6b\xd8\x17\xee"
    local s = tostring(uid)
    local h = {}
    for i = 1, 32 do h[i] = 0 end
    local idx = 1
    for i = 1, #salt do
        h[idx] = bit32.bxor(h[idx], salt:byte(i)) % 256
        idx = (idx % 32) + 1
    end
    for i = 1, #s do
        h[idx] = bit32.bxor(h[idx], s:byte(i)) % 256
        idx = (idx % 32) + 1
    end
    for round = 1, 8 do
        for i = 1, 32 do
            local j = (i % 32) + 1
            h[i] = bit32.bxor(h[i], bit32.lshift(h[j], 1) % 256) % 256
        end
    end
    return h
end

local function _xor(data, key)
    local out = {}
    for i = 1, #data do
        out[i] = string.char(bit32.bxor(data:byte(i), key[((i-1) % #key)+1]))
    end
    return table.concat(out)
end

