-- ============================================================
-- ⑯ 腹吸い付き（Delta専用）
-- ============================================================
local function getAimPart(char)
    if not char then return nil end
    return char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("LowerTorso")
        or char:FindFirstChild("HumanoidRootPart")
end
local function isTargetAlive(plr)
    if not plr or not plr.Character then return false end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function updateCameraLock()
    if not State.CameraLock then
        State.LockedTarget, State.LockedHRP, State.LockedChar, State.TrackedPlayer = nil,nil,nil,nil
        return
    end
    local tracked = State.TrackedPlayer
    local trackedValid = false
    if tracked and isTargetAlive(tracked) then
        local char = tracked.Character
        local aimPart = getAimPart(char)
        if aimPart and hasLineOfSight(char, aimPart.Position) then
            trackedValid = true
        end
    end
    if not trackedValid then
        State.TrackedPlayer, State.LockedTarget, State.LockedHRP, State.LockedChar = nil,nil,nil,nil
        local t = scanTargets()
        local target = t.circle
        if target then
            State.TrackedPlayer = target.plr
            State.LockedTarget = target.plr
            State.LockedHRP    = target.hrp
            State.LockedChar   = target.char
            trackedValid = true
        end
    end
    if not State.TrackedPlayer then return end
    local char = State.TrackedPlayer.Character
    if not char then return end
    local aimPart = getAimPart(char)
    if not aimPart then return end
    if not hasLineOfSight(char, aimPart.Position) then return end

    local camPos = Camera.CFrame.Position
    local lookAt = CFrame.lookAt(camPos, aimPart.Position)
    local raw = math.clamp(State.LockStrength, 0.05, 1.0)
    local alpha = 0.35 + raw * 0.65
    if State.TrackUntilLost then alpha = math.min(1.0, alpha + 0.08) end
    Camera.CFrame = Camera.CFrame:Lerp(lookAt, alpha)
end

