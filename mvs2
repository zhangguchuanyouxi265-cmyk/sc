    task.wait(1)
    hookAllTools()
    applyTeamFilter(char)
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then bp.ChildAdded:Connect(function(c) if c:IsA("Tool") then hookTool(c) end end) end
    char.ChildAdded:Connect(function(c) if c:IsA("Tool") then hookTool(c) end end)
end)
if LocalPlayer.Character then
    hookAllTools()
    applyTeamFilter(LocalPlayer.Character)
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
