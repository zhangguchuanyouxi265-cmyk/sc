local DeltaAPI = {}

-- GUI親（Deltaは gethui が必ず通る）
function DeltaAPI.getGuiParent()
    local ok, hui = pcall(gethui)
    if ok and hui then return hui end
    -- 万一の保険（Deltaでは基本通らない）
    return LocalPlayer:WaitForChild("PlayerGui")
end

-- GUI保護
function DeltaAPI.protectGui(gui)
    if Delta.protect_gui then
        pcall(function() Delta.protect_gui(gui) end)
    elseif protect_gui then
        pcall(function() protect_gui(gui) end)
    end
end

-- 通知（Deltaのトースト）
function DeltaAPI.notify(title, text, dur)
    dur = dur or 3
    if Delta.notify then
        pcall(function() Delta.notify(title, text, dur) end)
    elseif Delta.Toast then
        pcall(function() Delta.Toast(title .. ": " .. text, dur) end)
    end
end

-- タッチ送信（Delta優先）
function DeltaAPI.tap(x, y)
    -- Delta.tap があれば最優先
    if Delta.tap then
        local ok = pcall(function() Delta.tap(x, y) end)
        if ok then return true end
    end
    -- VirtualInputManager
    local VIM = game:GetService("VirtualInputManager")
    if VIM then
        pcall(function()
            VIM:SendTouchEvent(x, y, Enum.UserInputState.Begin, Enum.UserInputType.Touch)
        end)
        pcall(function()
            VIM:SendTouchEvent(x, y, Enum.UserInputState.End, Enum.UserInputType.Touch)
        end)
        return true
    end
    -- Deltaのマウスクリック
    if Delta.mouse1click then
        pcall(function() Delta.mouse1click() end)
        return true
    end
    return false
end

-- ファイル（DeltaのWorkspace固定）
DeltaAPI.WorkDir = "Delta/Workspace/"
DeltaAPI.ConfigFile = DeltaAPI.WorkDir .. "AvS2_Delta_Config.json"

function DeltaAPI.save(str)
    if writefile then
        pcall(function() writefile(DeltaAPI.ConfigFile, str) end)
    end
end
function DeltaAPI.load()
    if isfile and isfile(DeltaAPI.ConfigFile) then
        local ok, s = pcall(readfile, DeltaAPI.ConfigFile)
        if ok then return s end
    end
    return nil
end
function DeltaAPI.exists()
    return isfile and isfile(DeltaAPI.ConfigFile)
end

