local function removeEnemyMarkers()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if not char then continue end
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("Highlight") or obj:IsA("BillboardGui")
            or obj:IsA("SelectionBox") or obj:IsA("BoxHandleAdornment")
            or obj:IsA("SphereHandleAdornment") or obj:IsA("LineHandleAdornment") then
                pcall(function() obj:Destroy() end)
            end
        end
    end
end
task.spawn(function()
    while true do
        task.wait(State.LowLagMode and 1.5 or 0.8)
        pcall(removeEnemyMarkers)
    end
end)

