local function deepCopy(t) local o={} for k,v in pairs(t) do o[k]=v end return o end
local function saveConfig(d)
    if not DeltaAPI.save then return end
    DeltaAPI.save(HttpService:JSONEncode(d))
end
local function loadConfig()
    if not DeltaAPI.exists() then return deepCopy(DEFAULT_CONFIG) end
    local s = DeltaAPI.load()
    if not s then return deepCopy(DEFAULT_CONFIG) end
    local ok, d = pcall(HttpService.JSONDecode, HttpService, s)
    if ok and type(d)=="table" then
        local m = deepCopy(DEFAULT_CONFIG)
        for k,v in pairs(d) do m[k]=v end
        return m
    end
    return deepCopy(DEFAULT_CONFIG)
end
