RunService.RenderStepped:Connect(function()
    if State.ShowCircle then CircleFrame.Position = UDim2.new(0.5, 0, 0.5, 0) end
    updateCameraLock()
    local now = tick()
    if State.AutoFireCircle then
        local t = scanTargets()
        if t.circle then
            cStroke.Color = Color3.fromRGB(255,60,60)
            if now - State.LastFireTime >= State.AutoFireDelay then doFire(t.circle) end
        else
            cStroke.Color = Color3.fromRGB(0,255,130)
        end
        return
    end
    if State.TriggerbotOn then
        local t = scanTargets()
        local target = t.circle or t.any
        if target then
            cStroke.Color = Color3.fromRGB(255,60,60)
            if now - State.LastFireTime >= State.AutoFireDelay then doFire(target) end
        else
            cStroke.Color = Color3.fromRGB(0,255,130)
        end
    else
        cStroke.Color = Color3.fromRGB(120,120,140)
    end
end)

