local function hasLineOfSight(targetChar, targetPos)
    if not State.WallCheck then return true end
    local myChar = LocalPlayer.Character
    if not myChar then return false end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return false end
    local origin = Camera.CFrame.Position
    if (myHRP.Position - origin).Magnitude < 1.5 then
        origin = myHRP.Position + Vector3.new(0, 0.5, 0)
    end
    local pts = { targetPos }
    local hrp = targetChar:FindFirstChild("HumanoidRootPart")
    local torso = targetChar:FindFirstChild("UpperTorso")
        or targetChar:FindFirstChild("Torso")
        or targetChar:FindFirstChild("LowerTorso")
    if hrp then table.insert(pts, hrp.Position) end
    if torso then table.insert(pts, torso.Position) end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { myChar, targetChar, Camera }
    params.IgnoreWater = true

    for _, pt in ipairs(pts) do
        local r = workspace:Raycast(origin, pt - origin, params)
        if r then
            if r.Instance and r.Instance:IsDescendantOf(targetChar) then return true end
        else
            return true
        end
    end
    return false
end

-- ============================================================
-- ⑪ ターゲット取得
-- ============================================================
local function scanTargets()
    local now = tick()
    if State.LowLagMode and now - State.CacheTime < 0.05 and State.CachedTarget then
        return State.CachedTarget
    end
    local bestCircle, bestCircleDist = nil, math.huge
    local bestAny, bestAnyDist = nil, math.huge
    local myHRP = getMyHRP()
    local myPos = myHRP and myHRP.Position or Camera.CFrame.Position
    local vp = Camera.ViewportSize
    local cx, cy = vp.X/2, vp.Y/2

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if State.NoTeamKill and isTeammate(plr) then continue end
        local char = plr.Character
        if not char then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local head = char:FindFirstChild("Head")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local aimPos = head and head.Position or hrp.Position
        if not hasLineOfSight(char, aimPos) then continue end
        local sp, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        local wd = (hrp.Position - myPos).Magnitude
        if onScreen and sp.Z > 0
           and sp.X >= 0 and sp.X <= vp.X
           and sp.Y >= 0 and sp.Y <= vp.Y then
            if wd < bestAnyDist then
                bestAnyDist = wd
                bestAny = {plr=plr, char=char, hrp=hrp, head=head, dist=wd, screenPos=sp}
            end
            local dx, dy = sp.X - cx, sp.Y - cy
            local cd = math.sqrt(dx*dx + dy*dy)
            if cd <= State.CircleRadius and wd < bestCircleDist then
                bestCircleDist = wd
                bestCircle = {plr=plr, char=char, hrp=hrp, head=head, dist=wd, screenPos=sp, circleDist=cd}
            end
        end
    end
    local result = { circle = bestCircle, any = bestAny }
    State.CachedTarget = result
    State.CacheTime = now
    return result
end

-- ============================================================
-- ⑫ ヒットリモート
-- ============================================================
local function findHitRemotes()
    local remotes = {}
    local kws = {"hit","damage","attack","throw","slash","kill",
        "stab","shoot","fire","swing","knife","gun",
        "punch","melee","target","hurt","strike","weapon"}
    local function m(n)
        n = n:lower()
        for _, k in ipairs(kws) do if n:find(k,1,true) then return true end end
        return false
    end
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) and m(obj.Name) then
            table.insert(remotes, obj)
        end
    end
    return remotes
end
State.HitRemotes = findHitRemotes()

local function sendHit(target)
    if not target then return end
    for _, r in ipairs(State.HitRemotes) do
        if r:IsA("RemoteEvent") then
            pcall(function() r:FireServer(target.char, target.hrp) end)
            pcall(function() r:FireServer(target.plr) end)
            pcall(function() r:FireServer(target.hrp) end)
        elseif r:IsA("RemoteFunction") then
            pcall(function() r:InvokeServer(target.char, target.hrp) end)
        end
    end
    State.HitCount = State.HitCount + 1
end

local function assistBulletPath(target)
    if not target or not State.AimAssist then return end
    local sp = target.screenPos or Camera:WorldToViewportPoint(target.hrp.Position)
    if sp.Z <= 0 then return end
    State.TouchPos = Vector2.new(sp.X, sp.Y)
    State.TouchActive = true
    DeltaAPI.tap(sp.X, sp.Y)   -- ★ Delta専用タップ
end

-- ============================================================
-- ⑬ ツールフック
-- ============================================================
local function hookTool(tool)
    if not tool or not tool:IsA("Tool") then return end
    if tool:GetAttribute("AvS2_Hooked") then return end
    tool:SetAttribute("AvS2_Hooked", true)
    tool.Activated:Connect(function()
        if not State.TriggerbotOn and not State.TapHit then return end
        local t = scanTargets()
        local target = t.circle or t.any
        if target then task.wait(0.02); sendHit(target) end
    end)
end
local function hookAllTools()
    local char = LocalPlayer.Character
    if char then
        for _, o in ipairs(char:GetChildren()) do
            if o:IsA("Tool") then hookTool(o) end
        end
    end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then
        for _, o in ipairs(bp:GetChildren()) do
            if o:IsA("Tool") then hookTool(o) end
        end
    end
end

-- ============================================================
-- ⑭ 射撃
-- ============================================================
local function doFire(forceTarget)
    local now = tick()
    if now - State.LastFireTime < State.AutoFireDelay then return false end
    State.LastFireTime = now
    local target = forceTarget
    if not target then
        local t = scanTargets()
        target = t.circle or t.any
    end
    if not target then return false end
    assistBulletPath(target)
    local tool = getEquippedTool()
    if tool then pcall(function() tool:Activate() end) end
    task.wait(0.02)
    local t2 = scanTargets()
    local t2target = t2.circle or t2.any
    if t2target then sendHit(t2target) end
    StatusLabel.Text = "🎯 " .. target.plr.Name .. " | " .. math.floor(target.dist)
    return true
end

local function doTapHit()
    if not State.TapHit then return end
    local now = tick()
    if now - State.LastHitTime < State.HitDelay then return end
    State.LastHitTime = now
    State.TapCount = State.TapCount + 1
    doFire()
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Enum.UserInputType.Touch then
        if input.Position then
            State.TouchPos = Vector2.new(input.Position.X, input.Position.Y)
        end
        doTapHit()
    end
end)
UserInputService.TouchMoved:Connect(function(input, gpe)
    if gpe then return end
    if input.Position then
        State.TouchPos = Vector2.new(input.Position.X, input.Position.Y)
    end
    if State.TapHit then doTapHit() end
end)
UserInputService.TouchEnded:Connect(function() State.TouchActive = false end)

