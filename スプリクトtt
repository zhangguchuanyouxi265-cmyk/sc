SiteBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard("https://zhangguchanyuuxi265-cmyk.github.io/sc/")
        SiteBtn.Text = "サイトのURLをコピーしました！"
        task.wait(2)
        SiteBtn.Text = "🌐 元のサイトのURLをコピー"
    end
end)

