local function GetBestTargetPart()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local myRoot = character.HumanoidRootPart
    local closestDist = math.huge
    local targetPart = nil

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            if isEnemy(p) then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local enemyRoot = p.Character.HumanoidRootPart
                    local dist = (myRoot.Position - enemyRoot.Position).Magnitude
                    if dist <= TriggerBotCfg.MaxDistance then
                        local part = p.Character:FindFirstChild("Head") or enemyRoot
                        if (not TriggerBotCfg.WallCheck or RaycastCheck(part)) and dist < closestDist then
                            closestDist = dist
                            targetPart = part
                        end
                    end
                end
            end
        end
    end
    return targetPart
end

local function tryHookSilentAim()
    if type(hookfunction) ~= "function" then return false end
    local ok, CombatClient = pcall(function() return require(game.ReplicatedStorage.Client.Madwork.CombatClient) end)
    if not ok or not CombatClient then return false end

    task.spawn(function()
        while true do
            task.wait(0.05)
            if TriggerBotCfg.Enabled and TriggerBotController.IsFiringMagic and silentController.TargetPart then
            elseif TriggerBotCfg.Enabled then
                silentController.TargetPart = GetBestTargetPart()
            else
                silentController.TargetPart = nil
            end
        end
    end)

    local oldNewLocalEvent
    oldNewLocalEvent = hookfunction(CombatClient.NewLocalEvent, function(data)
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not character or not hrp then return oldNewLocalEvent(data) end

        if TriggerBotCfg.Enabled and silentController.TargetPart and data and typeof(data) == "table" then
            local targetPart = silentController.TargetPart
            local myPos = hrp.Position
            data.Position  = myPos
            data.Direction = (targetPart.Position - myPos).Unit
        end
        return oldNewLocalEvent(data)
    end)
    return true
end

tryHookSilentAim()

