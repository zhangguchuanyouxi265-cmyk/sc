-- 10. メインループ（即時反応）
-- ============================================================
RunService.Heartbeat:Connect(function()
    if not TriggerBotController.Patched then return end
    if not TriggerBotCfg.Enabled then 
        if leftOrb then leftOrb.Transparency = 1 end
        if rightOrb then rightOrb.Transparency = 1 end
        return 
    end
    if (tick() - TriggerBotController.LastShootTime) < TriggerBotController.CoolDown then return end
    if TriggerBotController.IsFiringMagic then return end

    local char = player.Character
    if not char then return end
    
    local tool = char:FindFirstChildOfClass("Tool")
    local holdingGun = tool and string.find(tool.Name, "Gun") and ((tick() - TriggerBotController.EquipTime) >= 0.5)
    if not holdingGun then 
        if leftOrb then leftOrb.Transparency = 1 end
        if rightOrb then rightOrb.Transparency = 1 end
        return 
    end

    if isReloading(char) then
        StatusLabel.Text = "ステータス: リロード待機中..."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
        if leftOrb then leftOrb.Transparency = 1 end
        if rightOrb then rightOrb.Transparency = 1 end
        return
    end

    local leftPos = getHandPosition("Left")
    local rightPos = getHandPosition("Right")
    if leftPos and rightPos then
        if not leftOrb or not leftOrb.Parent then leftOrb = createOrb(COLOR_BLUE, 1.5) end
        if not rightOrb or not rightOrb.Parent then rightOrb = createOrb(COLOR_RED, 1.5) end
        leftOrb.CFrame = CFrame.new(leftPos)
        rightOrb.CFrame = CFrame.new(rightPos)
        leftOrb.Transparency = 0.2
        rightOrb.Transparency = 0.2
    end

    local target = nil

    if TriggerBotCfg.Mode == "Center" then
        local vp = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        local unitRay = camera:ViewportPointToRay(vp.X, vp.Y)
        local rayResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000)
        if rayResult and rayResult.Instance then
            local model = rayResult.Instance:FindFirstAncestorOfClass("Model")
            if model and model:FindFirstChild("Humanoid") and model ~= player.Character then
                local plr = Players:GetPlayerFromCharacter(model)
                if (not plr or isEnemy(plr)) then
                    local rootPart = model:FindFirstChild("HumanoidRootPart")
                    if rootPart and RaycastCheck(rootPart) then
                        target = model
                    end
                end
            end
        end
    elseif TriggerBotCfg.Mode == "Visible" then
        local targetPlr = GetBestTarget()
        if targetPlr and targetPlr.Character then target = targetPlr.Character end
    end

    if target then
        if target ~= TriggerBotController.ReactionTarget then
            TriggerBotController.ReactionTarget = target
            TriggerBotController.ReactionStartTime = tick()
        end
        local delaySec = TriggerBotCfg.ReactionDelay / 10
        if (tick() - TriggerBotController.ReactionStartTime) >= delaySec then
            local targetRoot = target:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                FireMagicPurple(targetRoot)
            end
            TriggerBotController.ReactionTarget = nil
        end
    else
        StatusLabel.Text = "ステータス: 敵を探しています..."
        StatusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
        TriggerBotController.ReactionTarget = nil
    end
end)

