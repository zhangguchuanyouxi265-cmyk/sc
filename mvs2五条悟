local COLOR_BLUE = Color3.fromRGB(0, 150, 255)
local COLOR_RED = Color3.fromRGB(255, 0, 0)
local COLOR_PURPLE = Color3.fromRGB(160, 0, 255)

local function createOrb(color, size)
    local orb = Instance.new("Part")
    orb.Shape = Enum.PartType.Ball
    orb.Size = Vector3.new(size, size, size)
    orb.Color = color
    orb.Material = Enum.Material.Neon
    orb.Anchored = true
    orb.CanCollide = false
    orb.Transparency = 0.2
    orb.Parent = MagicFolder
    local light = Instance.new("PointLight")
    light.Color = color
    light.Range = 10
    light.Brightness = 2
    light.Parent = orb
    return orb
end

local function getHandPosition(side)
    local character = player.Character
    if not character then return nil end
    local handName = (side == "Left") and "LeftHand" or "RightHand"
    local hand = character:FindFirstChild(handName) or character:FindFirstChild(handName == "LeftHand" and "Left Arm" or "Right Arm")
    if hand then return hand.Position + (hand.CFrame.LookVector * 1.5) end
    return nil
end

-- ★ 確実に紫を出す発射処理
local function FireMagicPurple(targetEnemy)
    if TriggerBotController.IsFiringMagic then return end
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    -- リロード中は何もしない
    if isReloading(character) then return end
    
    local leftPos = getHandPosition("Left")
    local rightPos = getHandPosition("Right")
    if not leftPos or not rightPos then return end
    
    TriggerBotController.IsFiringMagic = true
    
    -- オーブ生成（既存があれば再利用、なければ作る）
    if not leftOrb or not leftOrb.Parent then leftOrb = createOrb(COLOR_BLUE, 1.5) end
    if not rightOrb or not rightOrb.Parent then rightOrb = createOrb(COLOR_RED, 1.5) end
    
    leftOrb.CFrame = CFrame.new(leftPos)
    rightOrb.CFrame = CFrame.new(rightPos)
    leftOrb.Transparency = 0.2
    rightOrb.Transparency = 0.2
    
    local centerPos = (leftPos + rightPos) / 2
    local mergeDuration = 0.15
    local startTime = tick()
    
    local mergeConnection
    mergeConnection = RunService.RenderStepped:Connect(function()
        local elapsed = tick() - startTime
        local progress = math.clamp(elapsed / mergeDuration, 0, 1)
        
        local leftCurrent = leftPos:Lerp(centerPos, progress)
        local rightCurrent = rightPos:Lerp(centerPos, progress)
        
        leftOrb.CFrame = CFrame.new(leftCurrent)
        rightOrb.CFrame = CFrame.new(rightCurrent)
        
        leftOrb.Transparency = 0.2 + (progress * 0.8)
        rightOrb.Transparency = 0.2 + (progress * 0.8)
        
        if progress >= 1 then
            mergeConnection:Disconnect()
            leftOrb.Transparency = 1
            rightOrb.Transparency = 1
            
            if not mergedOrb then mergedOrb = createOrb(COLOR_PURPLE, 2.5) end
            mergedOrb.CFrame = CFrame.new(centerPos)
            mergedOrb.Transparency = 0.2
            
            -- 視点固定で発射
            if targetEnemy and RaycastCheck(targetEnemy) then
                -- デバイスに応じた発射
                if Device.InputMode == "Console" then
                    -- コントローラー用
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.ButtonR2, false, game)
                    task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.ButtonR2, false, game)
                else
                    -- PC/モバイル用
                    VirtualInputManager:SendMouseButtonEvent(
                        camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2,
                        0, true, game, 1)
                    task.wait(0.05)
                    VirtualInputManager:SendMouseButtonEvent(
                        camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2,
                        0, false, game, 1)
                end
                
                TriggerBotController.Fired = true
                TriggerBotController.LastShootTime = tick()
                
                local startPos = character.HumanoidRootPart.Position + Vector3.new(0, 2, 0)
                local endPos = targetEnemy.Position
                local bullet = Instance.new("Part")
                bullet.Size = Vector3.new(0.5, 0.5, (endPos - startPos).Magnitude)
                bullet.Material = Enum.Material.Neon
                bullet.Color = COLOR_PURPLE
                bullet.Anchored = true
                bullet.CanCollide = false
                bullet.CFrame = CFrame.new(startPos, endPos)
                bullet.Parent = MagicFolder
                task.delay(0.3, function() if bullet then bullet:Destroy() end end)
            end
            
            if mergedOrb then mergedOrb:Destroy() mergedOrb = nil end
            task.wait(0.2)
            
            -- 次の準備（赤青を再表示）
            if TriggerBotCfg.Enabled then
                if not leftOrb or not leftOrb.Parent then leftOrb = createOrb(COLOR_BLUE, 1.5) end
                if not rightOrb or not rightOrb.Parent then rightOrb = createOrb(COLOR_RED, 1.5) end
                leftOrb.Transparency = 0.2
                rightOrb.Transparency = 0.2
            end
            
            TriggerBotController.IsFiringMagic = false
        end
    end)
end

