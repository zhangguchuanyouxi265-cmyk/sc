-- 12. キャラクター監視（死亡後も維持）
-- ============================================================
local function onCharacterAdded(char)
    task.wait(0.5)
    if TriggerBotCfg.Enabled then
        applyGunTransparency(char)
        keepGunEquipped(char)
        ActionBtn.Text = "紫の魔法弾 (ON)"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 200)
        StatusLabel.Text = "ステータス: 起動中（リスポーン）"
        StatusLabel.TextColor3 = Color3.fromRGB(200, 100, 255)
    end
end

player.CharacterAdded:Connect(onCharacterAdded)
if player.Character then onCharacterAdded(player.Character) end

