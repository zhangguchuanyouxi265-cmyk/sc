local Device = {
    Type = "PC",       -- "PC", "Mobile", "Console"
    InputMode = "PC",  -- 実際の入力モード
}

local function DetectDevice()
    local isTouch = UserInputService.TouchEnabled
    local isKeyboard = UserInputService.KeyboardEnabled
    local isGamepad = UserInputService.GamepadEnabled
    local isTenFoot = false
    pcall(function() isTenFoot = GuiService:IsTenFootInterface() end)

    if isTenFoot then
        Device.Type = "Console"
        Device.InputMode = "Console"
    elseif isTouch and not isKeyboard then
        Device.Type = "Mobile"
        Device.InputMode = "Touch"
    elseif isGamepad and not isKeyboard then
        Device.Type = "Console"
        Device.InputMode = "Console"
    else
        Device.Type = "PC"
        Device.InputMode = "PC"
    end
    print("[DeviceDetect] 機種: " .. Device.Type .. " / 入力モード: " .. Device.InputMode)
end

