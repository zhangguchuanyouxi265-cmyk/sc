local function applyGunTransparency(char)
    if not char then return end
    local function hideTool(tool)
        if tool:IsA("Tool") then
            task.wait(0.1)
            for _, part in ipairs(tool:GetDescendants()) do
                if part:IsA("BasePart") then part.Transparency = 1 end
            end
        end
    end
    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped then hideTool(equipped) end
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then hideTool(child) end
    end)
end

local function keepGunEquipped(char)
    if not char then return end
    local backpack = player:FindFirstChild("Backpack")
    if not backpack then return end
    
    task.spawn(function()
        while TriggerBotCfg.Enabled and char.Parent do
            task.wait(1)
            local equipped = char:FindFirstChildOfClass("Tool")
            if not equipped then
                for _, tool in ipairs(backpack:GetChildren()) do
                    if tool:IsA("Tool") and (tool.Name:lower():find("gun") or tool.Name:lower():find("revolver") or tool.Name:lower():find("pistol") or tool.Name:lower():find("rifle")) then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if hum then
                            pcall(function() hum:EquipTool(tool) end)
                        end
                        break
                    end
                end
            end
        end
    end)
end

