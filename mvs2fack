--  入力方式
--==============================
local function detectDefaultMode()
    if UIS.TouchEnabled and not UIS.KeyboardEnabled then return "Touch" end
    if UIS.GamepadEnabled and not UIS.KeyboardEnabled then return "Console" end
    return "PC"
end

local function resolveMode()
    local m = Config.InputMode
    if m == "Auto" then return detectDefaultMode() end
    return m
end

--==============================
--  発射ヘルパー
--==============================
local holdingMain, holdingAlt = false, false

local function getKeyCode(name)
    return Enum.KeyCode[name] or Enum.KeyCode.ButtonR2
end

local function fireDown(useAlt)
    local mode = resolveMode()
    local vp = camera.ViewportSize
    local x, y = vp.X / 2, vp.Y / 2

    if mode == "PC" then
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        end)
        holdingMain = true
    elseif mode == "Console" then
        local btnName = useAlt and Config.PadAltButton or Config.PadButton
        local code = getKeyCode(btnName)
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, code, false, game)
        end)
        if useAlt then holdingAlt = true else holdingMain = true end
    else
        pcall(function()
            VirtualInputManager:SendTouchEvent(x, y, true)
        end)
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        end)
        holdingMain = true
    end
end

local function fireUp(useAlt)
    local mode = resolveMode()
    local vp = camera.ViewportSize
    local x, y = vp.X / 2, vp.Y / 2

    if mode == "PC" then
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
        end)
        holdingMain = false
    elseif mode == "Console" then
        local btnName = useAlt and Config.PadAltButton or Config.PadButton
        local code = getKeyCode(btnName)
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, code, false, game)
        end)
        if useAlt then holdingAlt = false else holdingMain = false end
    else
        pcall(function()
            VirtualInputManager:SendTouchEvent(x, y, false)
        end)
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
        end)
        holdingMain = false
    end
end

local function fireReleaseAll()
    if holdingMain then fireUp(false) end
    if holdingAlt  then fireUp(true)  end
end

local function fireTap()
    fireDown(false)
    task.wait(0.02)
    fireUp(false)
end

