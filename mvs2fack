--  SilentAim（壁チェック強化）
--============================================================
local silentController = { TargetPart = nil }

local function tryHookSilentAim()
    if type(hookfunction) ~= "function" then
        warn("[MVS2] hookfunction 未対応: サイレント無効")
        return false
    end
    local ok, CombatClient = pcall(function()
        return require(game.ReplicatedStorage.Client.Madwork.CombatClient)
    end)
    if not ok or not CombatClient then
        warn("[MVS2] CombatClient 取得失敗: サイレント無効")
        return false
    end

    task.spawn(function()
        while true do
            task.wait(0.1)
            silentController.TargetPart = GetBestTargetPart(SilentAimCfg, nil)
        end
    end)

    local oldNewLocalEvent
    oldNewLocalEvent = hookfunction(CombatClient.NewLocalEvent, function(data)
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not character or not hrp then return oldNewLocalEvent(data) end

        if (SilentAimCfg.Enabled or Config.WallPierce)
           and silentController.TargetPart and data and typeof(data) == "table" then
            local targetPart = silentController.TargetPart
            -- ★壁チェック：透明壁も含めて確認
            if not Config.WallPierce and SilentAimCfg.WallCheck then
                if not RaycastCheck(targetPart, nil) then
                    return oldNewLocalEvent(data)
                end
            end
            local myPos = hrp.Position
            data.Position  = myPos
            data.Direction = (targetPart.Position - myPos).Unit
        end
        return oldNewLocalEvent(data)
    end)
    return true
end
tryHookSilentAim()

