local expanded = false
local function setExpanded(state)
    expanded = state
    if state then
        local maxH = math.min(camera.ViewportSize.Y * 0.75, 340)
        Main.Size = UDim2.new(0, 200, 0, maxH)
        Content.Visible = true
        btnToggle.Text = "▲"
    else
        Main.Size = UDim2.new(0, 200, 0, 36)
        Content.Visible = false
        btnToggle.Text = "▼"
    end
end
btnToggle.MouseButton1Click:Connect(function() setExpanded(not expanded) end)

--==============================
--  ドラッグ
--==============================
do
    local dragging, dragStart, startPos
    local function startDrag(input)
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
    local function updateDrag(input)
        if not dragging then return end
        local d = input.Position - dragStart
        local newX = startPos.X.Offset + d.X
        local newY = startPos.Y.Offset + d.Y
        local maxY = camera.ViewportSize.Y - Main.AbsoluteSize.Y
        local maxX = camera.ViewportSize.X - Main.AbsoluteSize.X
        newY = math.clamp(newY, 0, math.max(0, maxY))
        newX = math.clamp(newX, 0, math.max(0, maxX))
        Main.Position = UDim2.new(0, newX, 0, newY)
    end
    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            startDrag(input)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
           or input.UserInputType == Enum.UserInputType.Touch then
            updateDrag(input)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

