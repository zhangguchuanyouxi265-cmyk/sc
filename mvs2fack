local function makeToggle(jpLabel, yPos, xPos, getState, setState, onColor)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 90, 0, 30)
    btn.Position = UDim2.new(0, xPos, 0, yPos)
    btn.BackgroundColor3 = getState() and (onColor or Color3.fromRGB(80, 200, 120)) or Color3.fromRGB(50, 50, 60)
    btn.BorderSizePixel = 0
    btn.Text = jpLabel .. "：" .. (getState() and "ON" or "OFF")
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.Parent = Content
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn

    btn.MouseButton1Click:Connect(function()
        setState(not getState())
        local st = getState()
        btn.Text = jpLabel .. "：" .. (st and "ON" or "OFF")
        btn.BackgroundColor3 = st and (onColor or Color3.fromRGB(80, 200, 120)) or Color3.fromRGB(50, 50, 60)
    end)
    return btn
end

local function cfgToggle(tableRef)
    return
        function() return tableRef.Enabled end,
        function(v) tableRef.Enabled = v end
end

