local function waitForModule(path)
    local module
    repeat
        task.wait(0.2)
        pcall(function() module = require(path) end)
    until module
    return module
end

local function MobilePatch()
    pcall(function()
        local playerScripts = player:WaitForChild("PlayerScripts")
        local playerModule = waitForModule(playerScripts:WaitForChild("PlayerModule"))
        local controlModule = playerModule.controls or playerModule:GetActiveController()
        local thumbstickClass = waitForModule(
            playerScripts.PlayerModule.ControlModule:WaitForChild("DynamicThumbstick")
        )

        local targetStick
        repeat
            task.wait(0.5)
            if controlModule.controllers then
                targetStick = controlModule.controllers[thumbstickClass]
            end
            if not targetStick then
                controlModule = playerModule.controls or playerModule:GetActiveController()
            end
        until targetStick

        local originalSwitch = controlModule.SwitchToController
        controlModule.SwitchToController = function(self, ...)
            if ({...})[1] ~= targetStick then return end
            return originalSwitch(self, ...)
        end

        RunService.RenderStepped:Connect(function()
            local touchGui = player.PlayerGui:FindFirstChild("TouchGui")
            if touchGui and touchGui:IsA("ScreenGui") and TriggerBotCfg.Enabled then
                if not touchGui.Enabled then touchGui.Enabled = true end
                if not targetStick.enabled then
                    pcall(function() targetStick:Enable(true, touchGui) end)
                end
            end
        end)

        TriggerBotController.Patched = true
        print("[MVS2] Mobile patch applied")
    end)
end

if _G.Device == "Mobile" then
