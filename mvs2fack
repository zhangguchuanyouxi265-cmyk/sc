--  TriggerBot 本体
--============================================================
RunService.Heartbeat:Connect(function()
    if not TriggerBotController.Patched then return end
    if not TriggerBotCfg.Enabled then return end
    if (tick() - TriggerBotController.LastShootTime) < TriggerBotCfg.CoolDown then return end

    local char = player.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    local holdingGun = tool and string.find(tool.Name, "Gun")
        and ((tick() - TriggerBotController.EquipTime) >= 0.5)
    if not holdingGun then return end

    local target = nil

    if TriggerBotCfg.Mode == "Center" then
        local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        local ray = camera:ViewportPointToRay(center.X, center.Y)

        local result
        if Config.WallPierce then
            result = pierceRaycast(ray.Origin, ray.Direction * 5000, 5000)
        else
            result = workspace:Raycast(ray.Origin, ray.Direction * 1000)
        end

        if result and result.Instance then
            local model = result.Instance:FindFirstAncestorOfClass("Model")
            if model and model:FindFirstChild("Humanoid") and model ~= char then
                local plr = Players:GetPlayerFromCharacter(model)
                if (not plr) or isEnemy(plr) then
                    local root = model:FindFirstChild("HumanoidRootPart")
                    -- ★壁チェック：透明壁含めて確認
                    if root and canShoot(root) then
                        target = model
                    end
                end
            end
        end

    elseif TriggerBotCfg.Mode == "Visible" then
        local _, targetPlr = GetBestTargetPart(TriggerBotCfg, nil)
        if targetPlr and targetPlr.Character then
            target = targetPlr.Character
        end
    end

    if target then
        if target ~= TriggerBotController.ReactionTarget then
            TriggerBotController.ReactionTarget = target
            TriggerBotController.ReactionStartTime = tick()
        end

        local delaySec = TriggerBotCfg.ReactionDealy / 10
        if (tick() - TriggerBotController.ReactionStartTime) >= delaySec then
            TriggerBotController.Shooting = true
            fireTap()
            TriggerBotController.LastShootTime  = tick()
            TriggerBotController.ReactionTarget = nil
            TriggerBotController.Shooting = false
        end
    else
        TriggerBotController.ReactionTarget = nil
    end
end)

--==============================
--  AutoFire
--==============================
local AutoFireController = { LastFire = 0, AltToggle = false }

local function GetAutoFireTarget()
    if AutoFireCfg.OmniDirectional then
        local part, plr = GetOmniTarget(AutoFireCfg.OmniMaxDistance)
        if part and plr and plr.Character then
            return plr.Character, part
        end
        return nil
    end

    if AutoFireCfg.Mode == "Center" then
        local vc = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        local ray = camera:ViewportPointToRay(vc.X, vc.Y)
        local res
        if Config.WallPierce then
            res = pierceRaycast(ray.Origin, ray.Direction * 5000, 5000)
        else
            res = workspace:Raycast(ray.Origin, ray.Direction * (AutoFireCfg.MaxDistance or 400))
        end
        if res and res.Instance then
            local model = res.Instance:FindFirstAncestorOfClass("Model")
            if model and model ~= player.Character and model:FindFirstChild("Humanoid") then
                local plr = Players:GetPlayerFromCharacter(model)
                if (not plr) or isEnemy(plr) then
                    local root = model:FindFirstChild("HumanoidRootPart")
                    if root and canShoot(root) then
                        return model
                    end
                end
            end
        end
    elseif AutoFireCfg.Mode == "Visible" then
        local _, targetPlr = GetBestTargetPart({
            MaxDistance = AutoFireCfg.MaxDistance,
            WallCheck = AutoFireCfg.WallCheck, FOVCheck = false,
            ForceFieldCheck = true, TargetType = Config.AimPart,
        }, nil)
        if targetPlr and targetPlr.Character then
            local root = targetPlr.Character:FindFirstChild("HumanoidRootPart")
            if root and canShoot(root) then
                return targetPlr.Character
            end
        end
    end
    return nil
end

RunService.Heartbeat:Connect(function()
    if not AutoFireCfg.Enabled then
        fireReleaseAll()
        return
    end
    if (tick() - AutoFireController.LastFire) < AutoFireCfg.FireRate then return end

    local char = player.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not tool then
        fireReleaseAll()
        return
    end

    local target = GetAutoFireTarget()
    if not target then
        fireReleaseAll()
        return
    end

    local mode = resolveMode()

    if mode == "PC" or mode == "Console" then
        if mode == "Console" and Config.UseAltButton then
            AutoFireController.AltToggle = not AutoFireController.AltToggle
            if AutoFireController.AltToggle then
                if holdingMain then fireUp(false) end
                if holdingAlt  then fireUp(true)  end
                fireDown(false)
            else
                if holdingMain then fireUp(false) end
                if holdingAlt  then fireUp(true)  end
                fireDown(true)
            end
        else
            if not holdingMain then
                fireDown(false)
            else
                fireUp(false)
                task.wait(0.005)
                fireDown(false)
            end
        end
    else
        fireTap()
    end

    AutoFireController.LastFire = tick()
end)

