--============================================================
--  ★壁パーツ判定（強化版：透明壁も壁として認識）
--============================================================
-- 壁とみなす条件：
--   1. BasePart である
--   2. 自キャラ・他プレイヤーキャラの部位ではない
--   3. CanCollide = true（当たり判定がある）
--   4. Decorationという名前でない（装飾除外は任意）
--   5. Transparency は問わない（透明壁も壁）
--   6. サイズが極小すぎない（微小パーツノイズ除外）
local WallIgnoreNames = {
    ["Decoration"] = true,
    ["Hitbox"] = true,        -- ヒットボックスは壁じゃない
    ["HitBox"] = true,
}
local WallIgnoreTransparencyThreshold = 0.999  -- 完全透明(1.0)のみ除外（レーザー等）

local function isWallPart(part)
    if not part or not part:IsA("BasePart") then return false end
    if player.Character and part:IsDescendantOf(player.Character) then return false end
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character and part:IsDescendantOf(p.Character) then return false end
    end
    if WallIgnoreNames[part.Name] then return false end
    -- ★透明壁も壁として扱う：Transparency は原則問わない
    if part.Transparency >= WallIgnoreTransparencyThreshold then return false end
    -- CanCollide=false は通り抜け可能なので壁じゃない
    if not part.CanCollide then return false end
    return true
end

--============================================================
--  ★貫通レイキャスト（弾だけ壁貫通用）
--============================================================
local function pierceRaycast(origin, direction, maxDist)
    maxDist = maxDist or 1000
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    params.RespectCanCollide = false  -- CanCollide=falseの壁も検出したいので

    local ignoreList = {}
    if player.Character then table.insert(ignoreList, player.Character) end

    local currentOrigin = origin
    local remaining = direction
    local totalDist = direction.Magnitude
    if totalDist > maxDist then
        remaining = direction.Unit * maxDist
        totalDist = maxDist
    end

    local travelled = 0
    for _ = 1, 8 do
        params.FilterDescendantsInstances = ignoreList
        local result = workspace:Raycast(currentOrigin, remaining, params)
        if not result then return nil end
        local hit = result.Instance
        travelled = travelled + (result.Position - currentOrigin).Magnitude
        if isWallPart(hit) then
            table.insert(ignoreList, hit)
            currentOrigin = result.Position + remaining.Unit * 0.1
            remaining = remaining.Unit * math.max(0, totalDist - travelled)
            if remaining.Magnitude < 1 then return nil end
        else
            return result
        end
    end
    return nil
end

--============================================================
--  ★壁チェック（強化版：透明壁も遮蔽物として判定）
--============================================================
local function RaycastCheck(target, originPart)
    -- 壁貫通ONなら常に射線クリア
    if Config.WallPierce then return true end

    local character = player.Character
    if not character then return false end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local origin = (originPart and originPart:IsA("BasePart")) and originPart.Position or hrp.Position
    local ignore = { character }
    local targetChar = nil
    if typeof(target) == "Instance" then
        targetChar = target:FindFirstAncestorOfClass("Model")
        if targetChar and targetChar ~= character then
            table.insert(ignore, targetChar)
        end
        target = target:IsA("BasePart") and target.Position or target:GetPivot().Position
    end

    local params = RaycastParams.new()
    params.FilterDescendantsInstances = ignore
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    -- ★CanCollide=falseでも壁として判定したいため false
    params.RespectCanCollide = false

    local currentOrigin = origin
    for _ = 1, 6 do
        local dir = target - currentOrigin
        if dir.Magnitude < 0.1 then return true end

        local result = workspace:Raycast(currentOrigin, dir, params)
        if not result then return true end

        local hit = result.Instance
        -- ★透明壁も壁として判定（Transparencyは問わない）
        if isWallPart(hit) then
            return false  -- 遮蔽物あり
        else
            -- プレイヤーキャラの部位・ヒットボックス等は無視して続行
            table.insert(ignore, hit)
            params.FilterDescendantsInstances = ignore
            currentOrigin = result.Position + (dir.Unit * 0.05)
        end
    end
    return false
end

local function canShoot(target)
    if Config.WallPierce then return true end
    return RaycastCheck(target)
end

--==============================
--  部位取得
--==============================
local function getPartByType(character, partType, controller)
    if partType == "Head" then
        return character:FindFirstChild("Head")
    elseif partType == "Torso" then
        return character:FindFirstChild("UpperTorso")
            or character:FindFirstChild("Torso")
            or character:FindFirstChild("LowerTorso")
    elseif partType == "Foot" then
        return character:FindFirstChild("LeftFoot")
            or character:FindFirstChild("RightFoot")
            or character:FindFirstChild("LeftLowerLeg")
            or character:FindFirstChild("RightLowerLeg")
    elseif partType == "Random" then
        if controller and controller.TargetPart
           and controller.TargetPart:IsDescendantOf(character) then
            return controller.TargetPart
        end
        local valid = {}
        for _, c in ipairs(character:GetChildren()) do
            if c:IsA("BasePart") and c.Name ~= "HumanoidRootPart" then
                table.insert(valid, c)
            end
        end
        if #valid > 0 then return valid[math.random(1, #valid)] end
    end
    return nil
end

--==============================
--  ターゲット選定
--==============================
local function GetBestTargetPart(cfg, controller)
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local myRoot = character.HumanoidRootPart
    local closestDist = math.huge
    local targetPart, targetPlayer = nil, nil
    local aimPart = cfg.TargetType or Config.AimPart

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            if isEnemy(p) then
                if cfg.ForceFieldCheck and p.Character:FindFirstChildOfClass("ForceField") then continue end
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local enemyRoot = p.Character.HumanoidRootPart
                    local dist = (myRoot.Position - enemyRoot.Position).Magnitude
                    if dist > (cfg.MaxDistance or math.huge) then continue end

                    local part = getPartByType(p.Character, aimPart, controller) or enemyRoot
                    if not canShoot(part) then continue end

                    if dist < closestDist then
                        closestDist = dist
                        targetPlayer = p
                        targetPart = part
                    end
                end
            end
        end
    end

    if controller then
        controller.LastTargetPlayer = targetPlayer
        controller.TargetPart = targetPart
    end
    return targetPart, targetPlayer
end

--==============================
--  全方位ターゲット
--==============================
local function GetOmniTarget(maxDist)
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local myRoot = character.HumanoidRootPart
    local bestPart, bestPlayer, bestDist = nil, nil, math.huge

    for _, p in pairs(Players:GetPlayers()) do
        if isEnemy(p) and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                if p.Character:FindFirstChildOfClass("ForceField") then continue end
                local enemyRoot = p.Character.HumanoidRootPart
                local dist = (myRoot.Position - enemyRoot.Position).Magnitude
                if dist <= maxDist then
                    local part = getPartByType(p.Character, Config.AimPart) or enemyRoot
                    if canShoot(part) then
                        if dist < bestDist then
                            bestDist = dist
                            bestPart = part
                            bestPlayer = p
                        end
                    end
                end
            end
        end
    end
    return bestPart, bestPlayer
end

